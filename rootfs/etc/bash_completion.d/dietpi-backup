#!/bin/bash
{
	#////////////////////////////////////
	# DietPi-Backup bash completion
	#
	#////////////////////////////////////
	# Created by Joulinar / https://github.com/Joulinar
	#
	#////////////////////////////////////
	#
	# Info:
	# - Location: /etc/bash_completion.d/dietpi-backup
	# - Sourced by bash-completion in interactive bash shells
	# - Completes commands, backup locations and backup numbers on <tab>, e.g.: dietpi-backup restore <tab>
	#////////////////////////////////////

	_dietpi_backup()
	{
		# "prev" is not used, but set by _init_completion
		# shellcheck disable=SC2034
		local cur prev words cword
		_init_completion || return
		local cmd=${words[1]}
		# Match the whole word below the cursor, not only up to the cursor
		cur=${words[cword]}

		# Command
		if (( cword == 1 ))
		then
			mapfile -t COMPREPLY < <(compgen -W 'backup restore list' -- "$cur")
			return 0
		fi
		[[ $cmd == 'backup' || $cmd == 'restore' || $cmd == 'list' ]] || return 0

		# Configured backup location, read without sourcing the settings file
		local target='/mnt/dietpi-backup' dir='' number='' search='' i
		[[ -f '/boot/dietpi/.dietpi-backup_settings' ]] && i=$(sed -n "/^FP_TARGET=/{s/^FP_TARGET='//;s/'$//p;q}" /boot/dietpi/.dietpi-backup_settings) && [[ $i ]] && target=$i

		# Arguments given already
		for i in "${words[@]:2:cword-2}"
		do
			if [[ $cmd == 'restore' && $i =~ ^[1-9][0-9]*$ ]]
			then
				number=$i

			elif [[ $cmd == 'list' && $i == '--search' ]]
			then
				search=1

			elif [[ $i ]]
			then
				dir=$i
			fi
		done

		# Backup numbers: "data" = 1, "data_N" = N, from the given or configured location
		local numbers=()
		if [[ $cmd == 'restore' && ! $number ]]
		then
			[[ -d ${dir:-$target}/data ]] && numbers=(1)
			for i in "${dir:-$target}/data_"*
			do
				i=${i#"${dir:-$target}/data_"}
				[[ $i =~ ^[1-9][0-9]*$ ]] && numbers+=("$i")
			done
		fi

		# Numbers for restore
		if [[ ${numbers[0]} && ( $dir || $cur =~ ^[0-9]*$ ) ]]
		then
			mapfile -t COMPREPLY < <(compgen -W "${numbers[*]}" -- "$cur")
			[[ $dir ]] && return 0
		fi

		# List option
		[[ $cmd == 'list' && ! $dir && ! $search ]] && mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W '--search' -- "$cur")

		# Location, if not given already
		[[ $dir || $search ]] && return 0
		if [[ ! $cur ]]
		then
			COMPREPLY+=("$target")
		elif [[ $cur != [0-9-]* ]]
		then
			compopt -o filenames
			mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -d -- "$cur")
		fi
	}
	complete -F _dietpi_backup dietpi-backup /boot/dietpi/dietpi-backup
}
