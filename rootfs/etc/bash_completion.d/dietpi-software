#!/bin/bash
{
	#////////////////////////////////////
	# DietPi-Software bash completion
	#
	#////////////////////////////////////
	# Created by Joulinar / https://github.com/Joulinar
	#
	#////////////////////////////////////
	#
	# Info:
	# - Location: /etc/bash_completion.d/dietpi-software
	# - Sourced by bash-completion in interactive bash shells
	# - Completes commands and software IDs on <tab>, e.g.: dietpi-software install node<tab>
	# - Software IDs and install states are read from "dietpi-software list --machine-readable" and cached per shell session until dietpi-software or the install states file changes.
	#////////////////////////////////////

	_dietpi_software()
	{
		local cur=${COMP_WORDS[COMP_CWORD]} cmd=${COMP_WORDS[1]}
		COMPREPLY=()

		# Command
		if (( COMP_CWORD == 1 ))
		then
			mapfile -t COMPREPLY < <(compgen -W 'install reinstall uninstall list' -- "$cur")
			return 0
		fi

		# Options
		if [[ $cmd == 'list' ]]
		then
			(( COMP_CWORD == 2 )) && mapfile -t COMPREPLY < <(compgen -W '--machine-readable' -- "$cur")
			return 0
		fi
		[[ $cmd == 'install' || $cmd == 'reinstall' || $cmd == 'uninstall' ]] || return 0

		# Refresh cache if dietpi-software or the install states file changed
		local stamp
		stamp=$(stat -c '%Y' /boot/dietpi/dietpi-software /boot/dietpi/.installed 2> /dev/null)
		if [[ $stamp != "$_DIETPI_SOFTWARE_STAMP" ]]
		then
			_DIETPI_SOFTWARE_AVAILABLE=() _DIETPI_SOFTWARE_INSTALLED=()
			local id state
			while IFS='|' read -r id state _
			do
				# Skip software which is not available on this system
				[[ $id == *' DISABLED' ]] && continue
				if [[ $state == 2 ]]
				then
					_DIETPI_SOFTWARE_INSTALLED+=("$id")
				else
					_DIETPI_SOFTWARE_AVAILABLE+=("$id")
				fi
			# - Add sbin dirs for non-root users, else "modprobe" is not found and WireGuard is shown as disabled
			done < <(PATH="/usr/local/sbin:/usr/sbin:/sbin:$PATH" /boot/dietpi/dietpi-software list --machine-readable 2> /dev/null)
			_DIETPI_SOFTWARE_STAMP=$stamp
		fi

		# Software IDs: Offer not installed ones for install, installed ones for reinstall and uninstall, skip IDs given already
		local words=() i j
		if [[ $cmd == 'install' ]]
		then
			words=("${_DIETPI_SOFTWARE_AVAILABLE[@]}")
		else
			words=("${_DIETPI_SOFTWARE_INSTALLED[@]}")
		fi
		for i in "${COMP_WORDS[@]:2:COMP_CWORD-2}"
		do
			for j in "${!words[@]}"
			do
				[[ ${words[j]} == "$i" ]] && unset -v "words[j]"
			done
		done
		mapfile -t COMPREPLY < <(compgen -W "${words[*]}" -- "${cur,,}")
	}
	complete -F _dietpi_software dietpi-software /boot/dietpi/dietpi-software
}
