#!/bin/bash
{
	#////////////////////////////////////
	# DietPi-Software bash completion
	#
	#////////////////////////////////////
	# Created by Joulinar / https://github.com/Joulinar
	#
	#////////////////////////////////////
	#
	# Info:
	# - Location: /etc/bash_completion.d/dietpi-software
	# - Sourced by bash-completion in interactive bash shells
	# - Completes commands and software IDs on <tab>, e.g.: dietpi-software install node<tab>
	# - Software IDs and install states are read from "dietpi-software list --machine-readable" and cached per shell session until dietpi-software or the install states file changes.
	#////////////////////////////////////

	_dietpi_software()
	{
		# "prev" is not used, but set by _init_completion
		# shellcheck disable=SC2034
		local cur prev words cword
		_init_completion || return
		local cmd=${words[1]}
		# Match the whole word below the cursor, not only up to the cursor
		cur=${words[cword]}

		# Command
		if (( cword == 1 ))
		then
			mapfile -t COMPREPLY < <(compgen -W 'install reinstall uninstall list' -- "$cur")
			return 0
		fi

		# Options
		if [[ $cmd == 'list' ]]
		then
			(( cword == 2 )) && mapfile -t COMPREPLY < <(compgen -W '--machine-readable' -- "$cur")
			return 0
		fi
		[[ $cmd == 'install' || $cmd == 'reinstall' || $cmd == 'uninstall' ]] || return 0

		# Refresh cache if dietpi-software or the install states file changed
		local stamp
		stamp=$(stat -c '%Y' /boot/dietpi/dietpi-software /boot/dietpi/.installed 2> /dev/null)
		if [[ $stamp != "$_DIETPI_SOFTWARE_STAMP" ]]
		then
			_DIETPI_SOFTWARE_AVAILABLE=() _DIETPI_SOFTWARE_INSTALLED=() _DIETPI_SOFTWARE_REINSTALL=()
			local id state disabled
			while IFS='|' read -r id state _
			do
				disabled=
				[[ $id == *' DISABLED' ]] && id=${id% DISABLED} disabled=1
				if [[ $state == 2 ]]
				then
					# Uninstall depends on the install state only, reinstall requires the software to be available on this system
					_DIETPI_SOFTWARE_INSTALLED+=("$id")
					[[ $disabled ]] || _DIETPI_SOFTWARE_REINSTALL+=("$id")

				# Install requires the software to be available on this system
				elif [[ ! $disabled ]]
				then
					_DIETPI_SOFTWARE_AVAILABLE+=("$id")
				fi
			done < <(/boot/dietpi/dietpi-software list --machine-readable 2> /dev/null)
			_DIETPI_SOFTWARE_STAMP=$stamp
		fi

		# Software IDs: Offer not installed ones for install, installed ones for reinstall and uninstall, skip IDs given already
		local ids=() i j
		case $cmd in
			'install') ids=("${_DIETPI_SOFTWARE_AVAILABLE[@]}");;
			'reinstall') ids=("${_DIETPI_SOFTWARE_REINSTALL[@]}");;
			*) ids=("${_DIETPI_SOFTWARE_INSTALLED[@]}");;
		esac
		for i in "${words[@]:2:cword-2}"
		do
			# Convert given input to software ID like dietpi-software does, e.g. "Node-RED" to "nodered"
			i=${i//[^[:alnum:]]}
			i=${i,,}
			for j in "${!ids[@]}"
			do
				[[ ${ids[j]} == "$i" ]] && unset -v "ids[j]"
			done
		done
		cur=${cur//[^[:alnum:]]}
		mapfile -t COMPREPLY < <(compgen -W "${ids[*]}" -- "${cur,,}")
	}
	complete -F _dietpi_software dietpi-software /boot/dietpi/dietpi-software
}
