Age_Text()
{
	if (( $1 < 60 ))
	then
		AGE="${1}s"

	elif (( $1 < 3600 ))
	then
		AGE="$(( $1 / 60 ))m"

	elif (( $1 < 86400 ))
	then
		AGE="$(( $1 / 3600 ))h"
	else
		AGE="$(( $1 / 86400 ))d"
	fi
}

# Address list without host prefix lengths /32 and /128, or without any prefix lengths if $2 = 1 (for client Address)
Short_IPs(){ local a out=''; for a in ${1//,/ }; do a=${a%/32} a=${a%/128}; (( ${2:-0} )) && a=${a%/*}; out+=${out:+, }$a; done; echo "$out"; }

# The state starts with a 3 byte symbol, while printf pads by bytes, hence the state column width is 12 for 10 characters
Peer_Status_Text()
{
	local pub=${P_PUB[$1]} ips hs state
	ips=$(Short_IPs "${P_IPS[$1]}")
	hs=${HS[$pub]:-0}
	if [[ ${P_STATE[$1]} == 'disabled' ]]
	then
		state='○ disabled'

	elif (( ! $IFACE_UP ))
	then
		state='○ down'

	elif (( ! $hs ))
	then
		state='○ never'
	else
		Age_Text "$(( EPOCHSECONDS - $hs ))"
		(( EPOCHSECONDS - $hs < 180 )) && state='● online' || state='○ offline'
		printf '%-12s %-15s %4s ago  rx %s tx %s' "$state" "$ips" "$AGE" "$(numfmt --to=iec-i --suffix=B "${RX[$pub]:-0}")" "$(numfmt --to=iec-i --suffix=B "${TX[$pub]:-0}")"
		return
	fi
	printf '%-12s %s' "$state" "$ips"
	(( ${P_CLIENT[$1]} < 0 )) && printf '  no local config'
}

# Find peer index by public key into $PEER, after reloading
Reload_Peer()
{
	Load_State || return 1
	Load_Peers
	local i
	for i in "${!P_PUB[@]}"
	do
		[[ ${P_PUB[i]} == "$1" ]] && { PEER=$i; return 0; }
	done
	return 1
}

Input_AllowedIPs()
{
	local lan_ip lan_if lan_net=''
	lan_ip=$(G_GET_NET -q ip) lan_if=$(G_GET_NET -q iface)
	[[ $lan_if ]] && lan_net=$(ip -br -4 a s dev "$lan_if" | mawk '{print $3;exit}')
	if [[ $lan_net ]]
	then
		Parse_Net "$lan_net"
		Int2Ip "$NET4_NET"
		lan_net="$IP/$NET4_PREFIX"
	fi
	G_WHIP_MENU_ARRAY=('Full tunnel' ': 0.0.0.0/0, ::/0 | Route all traffic through the VPN')
	[[ $lan_net ]] && G_WHIP_MENU_ARRAY+=('Server LAN' ": $lan_net | Access the local network of the server only")
	[[ $lan_ip ]] && G_WHIP_MENU_ARRAY+=('Server only' ": $lan_ip/32 | Access this server only")
	G_WHIP_MENU_ARRAY+=('Custom' ": Enter AllowedIPs manually")
	case $1 in
		'0.0.0.0/0, ::/0') G_WHIP_DEFAULT_ITEM='Full tunnel';;
		"$lan_net") G_WHIP_DEFAULT_ITEM='Server LAN';;
		"$lan_ip/32") G_WHIP_DEFAULT_ITEM='Server only';;
