Menu_Main()
{
	# Without server config, show an empty server section with the option to create one
	if ! Load_State
	then
		G_WHIP_MENU_ARRAY=(
			'' '●─ Server '
			'Create server' ': Create a new server config and start it'
		)
		G_WHIP_DEFAULT_ITEM='Create server'
		G_WHIP_BUTTON_CANCEL_TEXT='Exit'
		Whip_Menu "No WireGuard server config was found in $WG_DIR. A server config is a file $WG_DIR/<interface>.conf with a \"ListenPort\" setting.\n\nCreate a server first, to add clients to it." || return 1
		[[ $G_WHIP_RETURNED_VALUE == 'Create server' ]] && Menu_Create
		return 0
	fi
	[[ $IFACE && ${SRV_PORT[$IFACE]} ]] || IFACE=${SERVERS[0]}
	Load_Peers
	Load_Runtime
	Load_Cleanup

	local state='inactive' boot='disabled at boot' i c tag unused=()
	declare -A tags=()
	systemctl -q is-active "wg-quick@$IFACE" && state='active'
	systemctl -q is-enabled "wg-quick@$IFACE" && boot='enabled at boot'

	G_WHIP_MENU_ARRAY=()
	(( ${#SERVERS[@]} > 1 )) && G_WHIP_MENU_ARRAY+=('Server interface' ": [$IFACE]")
	G_WHIP_MENU_ARRAY+=(
		'' "●─ Server $IFACE "
		'Service state' ": [$state, $boot]"
		'Listen port' ": [${SRV_PORT[$IFACE]}]"
		'Server address' ": [${SRV_ADDR[$IFACE]}]"
		'Edit config' ": Open $WG_DIR/$IFACE.conf in an editor"
		'' '●─ Clients '
	)
	# Client names are file names, which never contain spaces, unlike the fixed menu entries. Peers without client config are shown by public key.
	for i in "${!P_PUB[@]}"
	do
		tag=${P_NAME[i]:-<${P_PUB[i]::8}...>}
		while [[ ${tags[$tag]} ]]; do tag+='*'; done
		tags[$tag]="peer $i"
		G_WHIP_MENU_ARRAY+=("$tag" ": $(Peer_Status_Text "$i")")
	done
	G_WHIP_MENU_ARRAY+=('Add client' ': Create a new client')
	for c in "${!C_FILE[@]}"
	do
		[[ ${C_IF[c]} == "$IFACE" && ${C_STATE[c]} == 'unused' ]] && unused+=("$c")
	done
	if (( ${#unused[@]} || ${#KEY_FILES[@]} ))
	then
		G_WHIP_MENU_ARRAY+=('' '●─ Unused client configs ')
		for c in "${unused[@]}"
		do
			tag=${C_NAME[c]}
			while [[ ${tags[$tag]} ]]; do tag+='*'; done
			tags[$tag]="unused $c"
			G_WHIP_MENU_ARRAY+=("$tag" ": $(Short_IPs "${C_ADDR[c]}" 1) | not a peer of $IFACE")
		done
		(( ${#KEY_FILES[@]} )) && G_WHIP_MENU_ARRAY+=('Old key files' ": ${#KEY_FILES[@]} key file(s) not needed anymore")
	fi

	G_WHIP_DEFAULT_ITEM=$MAIN_LAST
	G_WHIP_BUTTON_CANCEL_TEXT='Exit'
	Whip_Menu "Manage WireGuard server $IFACE and its clients.\n\nPublic key: ${SRV_PUB[$IFACE]:-unknown, as the config has no PrivateKey and the interface is not running}" || return 1
	MAIN_LAST=$G_WHIP_RETURNED_VALUE
	case $G_WHIP_RETURNED_VALUE in
		'Server interface') Menu_Interface;;
		'Service state') Menu_Service;;
		'Listen port')
			G_WHIP_DEFAULT_ITEM=${SRV_PORT[$IFACE]}
			G_WHIP_INPUTBOX_REGEX='^[1-9][0-9]{0,4}$' G_WHIP_INPUTBOX_REGEX_TEXT='be a valid port number'
			Input_Checked Server_Set_Port "Please enter the UDP port the server $IFACE listens on:\n\nThis port needs to be forwarded by your router and/or opened in your firewall."
		;;
		'Server address')
			G_WHIP_DEFAULT_ITEM=${SRV_ADDR[$IFACE]}
			G_WHIP_INPUTBOX_REGEX='^[0-9A-Fa-f.:/, ]+$' G_WHIP_INPUTBOX_REGEX_TEXT='be a comma-separated list of addresses with prefix length'
			Input_Checked Server_Set_Address "Please enter the VPN address(es) of the server $IFACE with prefix length, comma-separated, e.g.: 10.9.0.1/24, fd42::1/64\n\nThe prefix length defines the subnet of the clients."
		;;
		'Edit config') Edit_Config;;
		'Add client') Menu_Add;;
		'Old key files')
			G_WHIP_YESNO "The following key files contain keys which are stored in configs already. They are not needed anymore:\n\n$(printf '%s\n' "${KEY_FILES[@]}")\n\nRemove them?" && G_EXEC rm "${KEY_FILES[@]}"
		;;
		*)
			[[ ${tags[$G_WHIP_RETURNED_VALUE]} ]] || return 0
			read -r tag i <<< "${tags[$G_WHIP_RETURNED_VALUE]}"
			if [[ $tag == 'peer' ]]
			then
				Menu_Peer "$i"
			else
				Menu_Unused "$i"
			fi
		;;
	esac
	return 0
}

#/////////////////////////////////////////////////////////////////////////////////////
# CLI
#/////////////////////////////////////////////////////////////////////////////////////
# Select server interface from -i option, or the only one
Select_Iface()
{
	if [[ $IFACE_OPT ]]
	then
		[[ ${SRV_PORT[$IFACE_OPT]} ]] || Error "Server interface \"$IFACE_OPT\" was not found. A server config is a file $WG_DIR/<interface>.conf with a \"ListenPort\" setting."
		IFACE=$IFACE_OPT

	elif (( ${#SERVERS[@]} == 1 ))
	then
		IFACE=${SERVERS[0]}
	else
		Error "Multiple server interfaces found: ${SERVERS[*]}. Please select one with -i <interface>."
	fi
	Load_Peers
}

# Find a client by name or public key into $IFACE, $TARGET_TYPE (peer or unused) and $TARGET
Find_Target()
{
	[[ $1 ]] || Error "Missing client name. Aborting ...$USAGE"
	local iface i c found=() list=("${SERVERS[@]}")
	[[ $IFACE_OPT ]] && { Select_Iface; list=("$IFACE"); }
	for iface in "${list[@]}"
	do
		IFACE=$iface
		Load_Peers
		for i in "${!P_PUB[@]}"
		do
			[[ ${P_NAME[i]} == "$1" || ${P_PUB[i]} == "$1" ]] && found+=("$iface peer $i")
		done
		for c in "${!C_FILE[@]}"
		do
			[[ ${C_IF[c]} == "$iface" && ${C_STATE[c]} == 'unused' && ${C_NAME[c]} == "$1" ]] && found+=("$iface unused $c")
		done
	done
	(( ${#found[@]} )) || Error "Client \"$1\" was not found."
	(( ${#found[@]} == 1 )) || Error "Client \"$1\" exists for multiple server interfaces. Please select one with -i <interface>."
	read -r IFACE TARGET_TYPE TARGET <<< "${found[0]}"
	Load_Peers
	Load_Server_Net
}

# Client config index of the target, error if there is none
Target_Client()
{
	if [[ $TARGET_TYPE == 'unused' ]]
	then
		CLIENT=$TARGET
	else
		CLIENT=${P_CLIENT[$TARGET]}
		(( $CLIENT >= 0 )) || Error "Peer ${P_PUB[$TARGET]} has no local client config."
	fi
}

Cmd_List()
{
	local list=("${SERVERS[@]}") iface i c rows=() row name address state config w1=4 w2=7
	if [[ $ARG1 || $IFACE_OPT ]]
	then
		IFACE_OPT=${ARG1:-$IFACE_OPT}
		Select_Iface
		list=("$IFACE")
	fi
	for iface in "${list[@]}"
	do
		IFACE=$iface
		Load_Peers
		(( ${#list[@]} > 1 )) && rows+=("#$iface")
		for i in "${!P_PUB[@]}"
		do
			config="(no local config, public key ${P_PUB[i]::8}...)"
			(( ${P_CLIENT[i]} < 0 )) || config=${C_FILE[${P_CLIENT[i]}]}
			rows+=("${P_NAME[i]:--}"$'\t'"$(Short_IPs "${P_IPS[i]}")"$'\t'"${P_STATE[i]}"$'\t'"$config")
		done
		for c in "${!C_FILE[@]}"
		do
			[[ ${C_IF[c]} == "$iface" && ${C_STATE[c]} == 'unused' ]] || continue
			rows+=("${C_NAME[c]}"$'\t'"$(Short_IPs "${C_ADDR[c]}" 1)"$'\t''unused'$'\t'"${C_FILE[c]}")
		done
	done
	for row in "${rows[@]}"
	do
		[[ $row == '#'* ]] && continue
		IFS=$'\t' read -r name address state config <<< "$row"
		(( ${#name} > $w1 )) && w1=${#name}
		(( ${#address} > $w2 )) && w2=${#address}
	done
	(( ${#list[@]} > 1 )) || printf '%-*s  %-*s  %-8s  %s\n' "$w1" 'NAME' "$w2" 'ADDRESS' 'STATE' 'CONFIG'
	for row in "${rows[@]}"
	do
		if [[ $row == '#'* ]]
		then
			printf '\nServer interface %s:\n%-*s  %-*s  %-8s  %s\n' "${row#\#}" "$w1" 'NAME' "$w2" 'ADDRESS' 'STATE' 'CONFIG'
			continue
		fi
		IFS=$'\t' read -r name address state config <<< "$row"
		printf '%-*s  %-*s  %-8s  %s\n' "$w1" "$name" "$w2" "$address" "$state" "$config"
	done
}

Cmd_Add()
{
	[[ $ARG1 ]] || Error "Missing client name. Aborting ...$USAGE"
	Select_Iface
	Load_Server_Net
	[[ $SRV4_IP ]] || Error "Server $IFACE has no IPv4 address."
	Load_Defaults
	local ip=$OPT_IP endpoint=${OPT_ENDPOINT:-$DEF_ENDPOINT} keepalive=${OPT_KEEPALIVE-$DEF_KEEPALIVE}
	[[ $ip ]] || { Next_Free_IP || Error "There is no free IP address left in the subnet $SRV4_IP/$SRV4_PREFIX."; ip=$NEXT_IP; }
	[[ $endpoint =~ :[0-9]+$ ]] || endpoint+=":${SRV_PORT[$IFACE]}"
	Client_Create "$ARG1" "$ip" "$endpoint" "${OPT_DNS-$DEF_DNS}" "${OPT_ALLOWED-$DEF_ALLOWED}" "$keepalive" "$OPT_PSK"
}

Cmd_Set()
{
	Find_Target "$ARG1"
	Target_Client
	(( ${#KV[@]} )) || Error "Missing <key>=<value>. Aborting ...$USAGE"
	local kv key value
	for kv in "${KV[@]}"
	do
		key=${kv%%=*} value=${kv#*=}
		case ${key,,} in
			'dns') Client_Set "$CLIENT" 'Interface' 'DNS' "$value";;
			'allowedips')
				Check_AllowedIPs "$value" || exit 1
				Client_Set "$CLIENT" 'Peer' 'AllowedIPs' "$value"
			;;
			'endpoint')
				Check_Endpoint "$value" || exit 1
				Client_Set "$CLIENT" 'Peer' 'Endpoint' "$value"
			;;
			'keepalive')
				Check_Keepalive "$value" || exit 1
				[[ $value == 0 ]] && value=
				Client_Set "$CLIENT" 'Peer' 'PersistentKeepalive' "$value"
			;;
			'psk')
				[[ $TARGET_TYPE == 'peer' ]] || Error 'A PresharedKey can only be changed for clients which are peers of the server.'
				[[ $value =~ ^(on|off)$ ]] || Error 'Valid values for psk are "on" and "off".'
				Client_PSK "$TARGET" "$([[ $value == 'on' ]] && echo 1 || echo 0)"
			;;
			*) Error "Invalid key ($key). Aborting ...$USAGE";;
		esac || exit 1
	done
}

Cmd_Init()
{
	# Do nothing if a server config exists already, e.g. on dietpi-software reinstalls
	if [[ $ARG1 && ${SRV_PORT[$ARG1]} ]]
	then
		G_DIETPI-NOTIFY 0 "Server config $WG_DIR/$ARG1.conf exists already"
		return 0

	elif [[ ! $ARG1 ]] && (( ${#SERVERS[@]} ))
	then
		G_DIETPI-NOTIFY 0 "Server config exists already: ${SERVERS[*]}"
		return 0
	fi
	Server_Defaults
	local iface=${ARG1:-$NEW_IFACE} port=$NEW_PORT address=$NEW_ADDR kv key value
	for kv in "${KV[@]}"
	do
		key=${kv%%=*} value=${kv#*=}
		case ${key,,} in
			'port') port=$value;;
			'address') address=$value;;
			*) Error "Invalid key ($key). Aborting ...$USAGE";;
		esac
	done
	Server_Create "$iface" "$port" "$address"
}

Cmd_Server()
{
	# Optional interface as first argument
	[[ $ARG1 ]] && IFACE_OPT=$ARG1
	Select_Iface
	(( ${#KV[@]} )) || Error "Missing <key>=<value>. Aborting ...$USAGE"
	local kv key value
	for kv in "${KV[@]}"
	do
		key=${kv%%=*} value=${kv#*=}
		case ${key,,} in
			'port') Server_Set_Port "$value";;
			'address') Server_Set_Address "$value";;
			*) Error "Invalid key ($key). Aborting ...$USAGE";;
		esac || exit 1
	done
}

Cmd_Cleanup()
{
	Load_Cleanup
	(( ${#CLEANUP_FILES[@]} )) || { G_DIETPI-NOTIFY 0 'Nothing to clean up.'; return 0; }
	printf ' - %s\n' "${CLEANUP_FILES[@]}"
	if Confirm "The following unused client configs and key files, which contain keys stored in configs already, are not needed anymore:\n\n$(printf '%s\n' "${CLEANUP_FILES[@]}")\n\nRemove them?"
	then
		G_EXEC rm "${CLEANUP_FILES[@]}"
	else
		G_DIETPI-NOTIFY 2 'Nothing has been removed. Use "-y" to remove the files without confirmation.'
	fi
}

#/////////////////////////////////////////////////////////////////////////////////////
# Main
#/////////////////////////////////////////////////////////////////////////////////////
Input "$@"
G_AG_CHECK_INSTALL_PREREQ wireguard-tools qrencode

# Private keys are stored in all configs we create or change. Set this after APT installs to not affect package files.
umask 0077

if [[ ! $COMMAND ]]
then
	MENU=1
	IFACE=$IFACE_OPT
	MAIN_LAST=
	while Menu_Main; do :; done
	exit 0
fi

Load_State || [[ $COMMAND == 'init' ]] || Error "No WireGuard server config was found in $WG_DIR. A server config is a file $WG_DIR/<interface>.conf with a \"ListenPort\" setting. Use \"dietpi-wireguard init\" to create one."
case $COMMAND in
	'init') Cmd_Init;;
	'list') Cmd_List;;
	'add') Cmd_Add;;
	'remove')
		Find_Target "$ARG1"
		Confirm "Remove client $ARG1 of server $IFACE? Its client config is deleted, which cannot be undone." || { G_DIETPI-NOTIFY 2 'Nothing has been removed. Use "-y" to remove the client without confirmation.'; exit 0; }
		if [[ $TARGET_TYPE == 'peer' ]]
		then
			Peer_Remove "$TARGET"
		else
			G_EXEC rm "${C_FILE[TARGET]}"
		fi
	;;
	'disable'|'enable')
		Find_Target "$ARG1"
		[[ $TARGET_TYPE == 'peer' ]] || Error "Client \"$ARG1\" is not a peer of $IFACE. Use \"dietpi-wireguard add\" to create a new client."
		state='active'
		[[ $COMMAND == 'disable' ]] && state='disabled'
		if [[ ${P_STATE[TARGET]} == "$state" ]]
		then
			G_DIETPI-NOTIFY 0 "Client \"$ARG1\" is ${COMMAND}d already"
		else
			Peer_Move "$TARGET" "$state"
		fi
	;;
	'qr')
		Find_Target "$ARG1"
		Target_Client
		Show_QR "${C_FILE[CLIENT]}" "${C_NAME[CLIENT]}"
	;;
	'rename')
		Find_Target "$ARG1"
		Target_Client
		[[ $ARG2 ]] || Error "Missing new client name. Aborting ...$USAGE"
		Client_Rename "$CLIENT" "$ARG2"
	;;
	'set') Cmd_Set;;
	'server') Cmd_Server;;
	'cleanup') Cmd_Cleanup;;
	*) :;;
esac || exit 1

exit 0
}
