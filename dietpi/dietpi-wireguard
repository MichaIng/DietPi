	case $G_WHIP_RETURNED_VALUE in
		'Full tunnel') RESULT='0.0.0.0/0, ::/0';;
		'Server LAN') RESULT=$lan_net;;
		'Server only') RESULT="$lan_ip/32";;
		*)
			G_WHIP_DEFAULT_ITEM=$1
			G_WHIP_INPUTBOX_REGEX='^[0-9A-Fa-f.:/, ]+$' G_WHIP_INPUTBOX_REGEX_TEXT='be a comma-separated list of networks'
			Input_Checked Check_AllowedIPs 'Please enter the AllowedIPs for the client, comma-separated, e.g.: 192.168.1.0/24, 10.9.0.0/24'
