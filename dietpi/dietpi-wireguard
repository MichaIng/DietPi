# Edit a copy of the server config, then apply it like any other change, restoring the previous config on failure
Edit_Config()
{
	local conf="$WG_DIR/$IFACE.conf" dir copy error restart=0
	dir=$(mktemp -d "$G_WORKING_DIR/tmp.XXXXXX") || return 1
	# wg-quick requires the file name to be <interface>.conf
	copy="$dir/$IFACE.conf"
	G_EXEC cp -a "$conf" "$copy"
	while :
	do
		sensible-editor "$copy"
		cmp -s "$conf" "$copy" && { G_EXEC rm -R "$dir"; return 0; }
		error=$(wg-quick strip "$copy" 2>&1 > /dev/null) && break
		G_WHIP_BUTTON_OK_TEXT='Edit' G_WHIP_BUTTON_CANCEL_TEXT='Discard' G_WHIP_YESNO "[FAILED] The config is invalid:\n\n$error\n\nEdit it again, or discard the changes?" && continue
		G_EXEC rm -R "$dir"
		return 0
	done
	[[ -e /sys/class/net/$IFACE ]] && G_WHIP_YESNO 'Restart the interface to apply all changes?\n\nConnected clients reconnect automatically. Otherwise, only changed peers are applied now, and changed [Interface] settings on next restart.' && restart=1
	Server_Commit "$copy" "$restart"
	G_EXEC rm -R "$dir"
}

