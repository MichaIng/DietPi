			'Show config') G_WHIP_VIEWFILE "${C_FILE[c]}";;
			'Rename') RENAME_FROM=${C_NAME[c]} Input_Name "${C_NAME[c]}" Check_Rename && [[ $RESULT != "${C_NAME[c]}" ]] && Client_Rename "$c" "$RESULT";;
			'AllowedIPs') Input_AllowedIPs "${CONF_P[1,allowedips]}" && Client_Set "$c" 'Peer' 'AllowedIPs' "$RESULT";;
			'Endpoint') Input_Endpoint "${CONF_P[1,endpoint]}" && Client_Set "$c" 'Peer' 'Endpoint' "$RESULT";;
			'DNS') Input_DNS "${CONF_I[dns]}" && Client_Set "$c" 'Interface' 'DNS' "$RESULT";;
			'Keepalive') Input_Keepalive "${CONF_P[1,persistentkeepalive]}" && Client_Set "$c" 'Peer' 'PersistentKeepalive' "$RESULT";;
			'PresharedKey') Client_PSK "$i" "$([[ $psk_text == 'Off' ]] && echo 1 || echo 0)";;
