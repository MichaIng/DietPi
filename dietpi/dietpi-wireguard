#!/bin/bash
{
# --------------------------------------------
# dietpi-wireguard
# Manage WireGuard server interfaces and their clients
# --------------------------------------------
# Created by Joulinar / https://github.com/Joulinar
# License: GPLv2 / https://github.com/MichaIng/DietPi#license
# --------------------------------------------
# Location: /boot/dietpi/dietpi-wireguard
# - Works with the existing configs in /etc/wireguard, without an own database: https://github.com/MichaIng/DietPi/issues/3100
#	- Server: /etc/wireguard/<interface>.conf with "ListenPort"
#	- Client: config whose peer public key is the one of a local server, matched to the server peer by its own public key
#	- Unused client config: client config of a local server, whose public key is not (anymore) a peer of that server
#	- Client names are taken from file names: <interface>-<name>.conf
# - New and changed client configs are stored in /etc/wireguard/clients/, configs found in /etc/wireguard/ are moved there on change.
# - Disabled peers are moved from /etc/wireguard/<interface>.conf to /etc/wireguard/<interface>.disabled.
# - Runtime state is shown in the menu only. On the command line, use "wg show" for it.
# - If no server config exists, a new one with defaults can be created via menu or "dietpi-wireguard init", which is used by dietpi-software as well.
readonly USAGE='
Usage: dietpi-wireguard [<command>] [<options>]
Available commands:
  <empty>                         Open the interactive menu
  init [<interface>] [<key>=<value>...]
                                  Create a server config with defaults and start it, if no server config exists yet: port, address
                                  The interface defaults to the first free wg0, wg1, ...
  list [<interface>]              List clients with address, state and config file
  add <name> [<options>]          Create a new client and add it as peer to the server
  remove <name>                   Remove a client: its server peer and its client config, after confirmation
  disable <name>                  Disable a client: remove its server peer, but keep it for re-enabling
  enable <name>                   Enable a disabled client again
  qr <name>                       Print the client config as QR code, without comments
  rename <name> <new name>        Rename a client config
  set <name> <key>=<value>...     Change client settings: dns, allowedips, endpoint, keepalive, psk=on|off
                                  An empty dns or keepalive value removes the setting.
  server [<interface>] <key>=<value>...
                                  Change server settings: port, address
  cleanup                         Remove unused client configs and key files which are not needed anymore, after confirmation
Available options:
  -i <interface>                  Server interface, required only if more than one server config exists
  -y                              Do not ask for confirmation
  --ip <address>                  Client VPN IPv4 address, defaults to the next free one
  --dns <servers>                 Client DNS servers, comma-separated, empty for none
  --allowed-ips <networks>        Client AllowedIPs, comma-separated
  --endpoint <host>[:<port>]      Server endpoint for the client, port defaults to the server ListenPort
  --keepalive <seconds>           Client PersistentKeepalive, 0 for none
  --psk                           Add a PresharedKey
Defaults for "add" are taken from the newest client config of the same server.
<name> can also be the public key of a peer without local client config.
'

. /boot/dietpi/func/dietpi-globals
readonly G_PROGRAM_NAME='DietPi-WireGuard'
G_CHECK_ROOT_USER "$@"
G_CHECK_ROOTFS_RW
G_INIT

readonly WG_DIR='/etc/wireguard'
readonly CLIENT_DIR="$WG_DIR/clients"

COMMAND=
ARG1=
ARG2=
KV=()
IFACE_OPT=
YES=0
MENU=0
# Error of the last action in menu mode, shown once in the next menu or input box
MENU_ERROR=
# Current client name while renaming it in the menu
RENAME_FROM=
OPT_IP=
OPT_ENDPOINT=
OPT_PSK=0
# Unset means "use default", empty means "none"
unset -v OPT_DNS OPT_ALLOWED OPT_KEEPALIVE

# Parsed config: [Interface] keys and [Peer] keys by "<peer number>,<key>", keys in lowercase, repeated keys joined with ", "
declare -A CONF_I CONF_P
CONF_PEERS=0
# Servers by interface name
SERVERS=()
declare -A SRV_PUB SRV_PORT SRV_ADDR SRV_PEERS SRV_DISABLED
# Client configs of local servers
C_FILE=() C_NAME=() C_IF=() C_PUB=() C_ADDR=() C_STATE=()
# Peers of the selected server interface, active and disabled
IFACE=
P_PUB=() P_IPS=() P_STATE=() P_CLIENT=() P_NAME=()
# Runtime state of the selected server interface
IFACE_UP=0
declare -A HS RX TX
# Keys found in any config, to detect key files which are not needed anymore
declare -A KNOWN_KEYS
declare -A PUB_CACHE

Error(){ G_DIETPI-NOTIFY 1 "$1"; exit 1; }

# Print an error, or in menu mode store it to be shown inline in the next menu or input box
Fail()
{
	if (( $MENU ))
	then
		MENU_ERROR="[FAILED] $1\n\n"
	else
		G_DIETPI-NOTIFY 1 "$1"
	fi
	return 1
}

# G_WHIP_MENU with the error of the last action prepended once
Whip_Menu()
{
	local error=$MENU_ERROR
	MENU_ERROR=
	G_WHIP_MENU "$error$1"
}

# G_WHIP_INPUTBOX, shown again with the error prepended until function $1 accepts the input, or the user cancels
# - G_WHIP_DEFAULT_ITEM, G_WHIP_INPUTBOX_REGEX and G_WHIP_INPUTBOX_REGEX_TEXT are applied to every attempt.
# - Return code 1 of $1 means invalid input. Any other error code means the input was applied, but something failed afterwards, hence it is not asked again, and the error is shown in the next menu.
Input_Checked()
{
	local check=$1 message=$2 default=$G_WHIP_DEFAULT_ITEM regex=$G_WHIP_INPUTBOX_REGEX regex_text=$G_WHIP_INPUTBOX_REGEX_TEXT error result
	while :
	do
		error=$MENU_ERROR
		MENU_ERROR=
		G_WHIP_DEFAULT_ITEM=$default G_WHIP_INPUTBOX_REGEX=$regex G_WHIP_INPUTBOX_REGEX_TEXT=$regex_text G_WHIP_INPUTBOX "$error$message" || return 1
		RESULT=$G_WHIP_RETURNED_VALUE
		"$check" "$RESULT"
		result=$?
		(( $result == 1 )) || return "$result"
		default=$RESULT
	done
}

Confirm(){ (( $YES )) || G_WHIP_YESNO "$1"; }

Input()
{
	while (( $# ))
	do
		case $1 in
			'-i') shift; IFACE_OPT=$1;;
			'-y') YES=1;;
			'--ip') shift; OPT_IP=$1;;
			'--dns') shift; OPT_DNS=$1;;
			'--allowed-ips') shift; OPT_ALLOWED=$1;;
			'--endpoint') shift; OPT_ENDPOINT=$1;;
			'--keepalive') shift; OPT_KEEPALIVE=$1;;
			'--psk') OPT_PSK=1;;
			'-h'|'--help'|'help') echo "$USAGE"; exit 0;;
			*)
				if [[ ! $COMMAND ]]
				then
					[[ $1 =~ ^(init|list|add|remove|disable|enable|qr|rename|set|server|cleanup)$ ]] || Error "Invalid command ($1). Aborting ...$USAGE"
					COMMAND=$1

				# Public keys end with "=", hence for "set" the client name comes first
				elif [[ $1 =~ ^[A-Za-z]+= && ( $COMMAND =~ ^(init|server)$ || ( $COMMAND == 'set' && $ARG1 ) ) ]]
				then
					KV+=("$1")

				elif [[ ! $ARG1 && $COMMAND != 'cleanup' ]]
				then
					ARG1=$1

				# Only "rename" takes a second argument
				elif [[ ! $ARG2 && $COMMAND == 'rename' ]]
				then
					ARG2=$1
				else
					Error "Invalid input ($1). Aborting ...$USAGE"
				fi
			;;
		esac
		shift
	done
}

#/////////////////////////////////////////////////////////////////////////////////////
# Reading configs
#/////////////////////////////////////////////////////////////////////////////////////
# Derive public key from private key into $PUBKEY
Pubkey()
{
	PUBKEY=
	[[ $1 ]] || return 1
	[[ ${PUB_CACHE[$1]} ]] || PUB_CACHE[$1]=$(wg pubkey <<< "$1")
	PUBKEY=${PUB_CACHE[$1]}
}

Known(){ local k; for k in "$@"; do [[ $k ]] && KNOWN_KEYS[$k]=1; done; }

# Parse a config into CONF_I and CONF_P, like wg-quick, ignoring comments
Parse_Conf()
{
	CONF_I=() CONF_P=() CONF_PEERS=0
	local sec key value
	while IFS=$'\t' read -r sec key value
	do
		if [[ $sec == 'I' ]]
		then
			CONF_I[$key]+=${CONF_I[$key]:+, }$value
		else
			sec=${sec#P}
			CONF_P[$sec,$key]+=${CONF_P[$sec,$key]:+, }$value
			CONF_PEERS=$sec
		fi
	done < <(mawk '{
		sub(/#.*/, ""); gsub(/^[ \t]+|[ \t\r]+$/, "")
		if ($0 == "") next
		if ($0 ~ /^\[/) { s = tolower($0); if (s == "[interface]") sec = "I"; else if (s == "[peer]") sec = "P" (++p); else sec = ""; next }
		i = index($0, "=")
		if (!i || sec == "") next
		k = tolower(substr($0, 1, i - 1)); v = substr($0, i + 1)
		gsub(/[ \t]+/, "", k); sub(/^[ \t]+/, "", v)
		print sec "\t" k "\t" v
	}' "$1")
}

# Find all server configs and client configs of local servers
Load_State()
{
	SERVERS=() SRV_PUB=() SRV_PORT=() SRV_ADDR=() SRV_PEERS=() SRV_DISABLED=() KNOWN_KEYS=()
	C_FILE=() C_NAME=() C_IF=() C_PUB=() C_ADDR=() C_STATE=()
	local f iface i n candidates=() seen=' '
	shopt -s nullglob
	for f in "$WG_DIR"/*.conf
	do
		Parse_Conf "$f"
		[[ ${CONF_I[listenport]} ]] || { candidates+=("$f"); continue; }
		iface=${f##*/} iface=${iface%.conf}
		SERVERS+=("$iface")
		SRV_PORT[$iface]=${CONF_I[listenport]}
		SRV_ADDR[$iface]=${CONF_I[address]}
		# The private key might be set via hook command instead, e.g. "PostUp = wg set %i private-key <file>", then get the public key from the running interface
		if Pubkey "${CONF_I[privatekey]}"
		then
			SRV_PUB[$iface]=$PUBKEY

		elif [[ -e /sys/class/net/$iface ]]
		then
			SRV_PUB[$iface]=$(wg show "$iface" public-key)
		fi
		Known "${CONF_I[privatekey]}" "${SRV_PUB[$iface]}"
		SRV_PEERS[$iface]=' '
		for (( i=1; i<=$CONF_PEERS; i++ ))
		do
			SRV_PEERS[$iface]+="${CONF_P[$i,publickey]} "
			Known "${CONF_P[$i,publickey]}" "${CONF_P[$i,presharedkey]}"
		done
		SRV_DISABLED[$iface]=' '
		[[ -f $WG_DIR/$iface.disabled ]] || continue
		Parse_Conf "$WG_DIR/$iface.disabled"
		for (( i=1; i<=$CONF_PEERS; i++ ))
		do
			SRV_DISABLED[$iface]+="${CONF_P[$i,publickey]} "
			Known "${CONF_P[$i,publickey]}" "${CONF_P[$i,presharedkey]}"
		done
	done

	# Client configs: /etc/wireguard/clients/ first, so they take precedence over copies in /etc/wireguard/
	for f in "$CLIENT_DIR"/*.conf "${candidates[@]}"
	do
		Parse_Conf "$f"
		[[ ${CONF_I[privatekey]} && ${CONF_P[1,publickey]} ]] || continue
		Pubkey "${CONF_I[privatekey]}"
		[[ $PUBKEY && $seen != *" $PUBKEY "* ]] || continue
		seen+="$PUBKEY "
		Known "${CONF_I[privatekey]}" "$PUBKEY" "${CONF_P[1,presharedkey]}"

		# Local server this client connects to, else it is a connection to an external server, which is not handled yet
		iface=
		for i in "${SERVERS[@]}"
		do
			[[ ${SRV_PUB[$i]} == "${CONF_P[1,publickey]}" ]] || continue
			iface=$i
			break
		done
		[[ $iface ]] || continue

		n=${#C_FILE[@]}
		C_FILE[n]=$f C_IF[n]=$iface C_PUB[n]=$PUBKEY C_ADDR[n]=${CONF_I[address]}
		C_NAME[n]=${f##*/} C_NAME[n]=${C_NAME[n]%.conf} C_NAME[n]=${C_NAME[n]#"$iface-"}
		if [[ ${SRV_PEERS[$iface]} == *" $PUBKEY "* ]]
		then
			C_STATE[n]='active'

		elif [[ ${SRV_DISABLED[$iface]} == *" $PUBKEY "* ]]
		then
			C_STATE[n]='disabled'
		else
			C_STATE[n]='unused'
		fi
	done
	shopt -u nullglob

	(( ${#SERVERS[@]} ))
}

# Load active and disabled peers of $IFACE and match them to client configs
Load_Peers()
{
	P_PUB=() P_IPS=() P_STATE=() P_CLIENT=() P_NAME=()
	local state f i c n
	for state in 'active' 'disabled'
	do
		f="$WG_DIR/$IFACE.conf"
		[[ $state == 'disabled' ]] && f="$WG_DIR/$IFACE.disabled"
		[[ -f $f ]] || continue
		Parse_Conf "$f"
		for (( i=1; i<=$CONF_PEERS; i++ ))
		do
			[[ ${CONF_P[$i,publickey]} ]] || continue
			n=${#P_PUB[@]}
			P_PUB[n]=${CONF_P[$i,publickey]} P_IPS[n]=${CONF_P[$i,allowedips]} P_STATE[n]=$state P_CLIENT[n]=-1 P_NAME[n]=
			for c in "${!C_FILE[@]}"
			do
				[[ ${C_IF[c]} == "$IFACE" && ${C_PUB[c]} == "${P_PUB[n]}" ]] || continue
				P_CLIENT[n]=$c P_NAME[n]=${C_NAME[c]}
				break
			done
		done
	done
}

# Load handshake and transfer data of $IFACE peers
Load_Runtime()
{
	HS=() RX=() TX=() IFACE_UP=0
	[[ -e /sys/class/net/$IFACE ]] || return 0
	IFACE_UP=1
	local pub psk endpoint ips hs rx tx keepalive
	while read -r pub psk endpoint ips hs rx tx keepalive
	do
		HS[$pub]=$hs RX[$pub]=$rx TX[$pub]=$tx
	done < <(wg show "$IFACE" dump | tail -n +2)
}

Ip2Int(){ local IFS=. a b c d; read -r a b c d <<< "$1"; INT=$(( ($a << 24) + ($b << 16) + ($c << 8) + $d )); }
Int2Ip(){ IP="$(( $1 >> 24 & 255 )).$(( $1 >> 16 & 255 )).$(( $1 >> 8 & 255 )).$(( $1 & 255 ))"; }
# No leading zeros, which would be interpreted as octal numbers
Valid_IPv4(){ [[ $1 =~ ^(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})$ ]] && (( ${BASH_REMATCH[1]} < 256 && ${BASH_REMATCH[2]} < 256 && ${BASH_REMATCH[3]} < 256 && ${BASH_REMATCH[4]} < 256 )); }

# Parse an address list into first IPv4 and IPv6 address, prefix length and IPv4 network/broadcast as integer
Parse_Net()
{
	NET4_IP='' NET4_PREFIX='' NET4_NET='' NET4_BCAST='' NET6_IP='' NET6_PREFIX=''
	local a mask
	for a in ${1//,/ }
	do
		if [[ ! $NET4_IP && $a =~ ^[0-9.]+(/[0-9]{1,2})?$ ]] && Valid_IPv4 "${a%/*}"
		then
			NET4_IP=${a%/*} NET4_PREFIX=32
			[[ $a == */* ]] && NET4_PREFIX=${a#*/}

		elif [[ ! $NET6_IP && $a == *':'* ]]
		then
			NET6_IP=${a%/*} NET6_PREFIX=128
			[[ $a == */* ]] && NET6_PREFIX=${a#*/}
		fi
	done
	[[ $NET4_IP ]] || return 0
	Ip2Int "$NET4_IP"
	mask=$(( (0xFFFFFFFF << (32 - $NET4_PREFIX)) & 0xFFFFFFFF ))
	NET4_NET=$(( $INT & $mask )) NET4_BCAST=$(( ($INT & $mask) | (~$mask & 0xFFFFFFFF) ))
}

Load_Server_Net()
{
	Parse_Net "${SRV_ADDR[$IFACE]}"
	SRV4_IP=$NET4_IP SRV4_PREFIX=$NET4_PREFIX SRV4_NET=$NET4_NET SRV4_BCAST=$NET4_BCAST SRV6_IP=$NET6_IP SRV6_PREFIX=$NET6_PREFIX
}

# Addresses in use by the server, its peers and client configs of $IFACE: IPv4 as integer keys of USED4, IPv6 as space-separated list USED6
Load_Used()
{
	USED4=() USED6=' '
	local list a i c
	list=${SRV_ADDR[$IFACE]}
	for i in "${!P_IPS[@]}"; do list+=", ${P_IPS[i]}"; done
	for c in "${!C_FILE[@]}"; do [[ ${C_IF[c]} == "$IFACE" ]] && list+=", ${C_ADDR[c]}"; done
	for a in ${list//,/ }
	do
		a=${a%/*}
		[[ $a == *':'* ]] && { USED6+="${a,,} "; continue; }
		Valid_IPv4 "$a" || continue
		Ip2Int "$a"
		USED4[$INT]=1
	done
}
declare -A USED4

Next_Free_IP()
{
	NEXT_IP=
	[[ $SRV4_IP ]] || return 1
	Load_Used
	local i
	for (( i=$SRV4_NET+1; i<$SRV4_BCAST; i++ ))
	do
		[[ ${USED4[$i]} ]] && continue
		Int2Ip "$i"
		NEXT_IP=$IP
		return 0
	done
	return 1
}

# Check whether an IPv4 address can be used for a new client of $IFACE
Check_Client_IP()
{
	Valid_IPv4 "$1" || { Fail "\"$1\" is not a valid IPv4 address."; return 1; }
	[[ $SRV4_IP ]] || { Fail "Server $IFACE has no IPv4 address."; return 1; }
	Load_Used
	Ip2Int "$1"
	(( $INT > $SRV4_NET && $INT < $SRV4_BCAST )) || { Fail "$1 is not inside the server subnet $SRV4_IP/$SRV4_PREFIX."; return 1; }
	[[ ! ${USED4[$INT]} ]] || { Fail "$1 is used already."; return 1; }
}

# Check client settings, which are not validated by WireGuard until the config is imported on the client device
Check_AllowedIPs()
{
	local a ip prefix max
	[[ ${1//[ ,]/} ]] || { Fail 'AllowedIPs must not be empty.'; return 1; }
	for a in ${1//,/ }
	do
		# The prefix length is optional, like for WireGuard
		ip=${a%/*} prefix=${a#"${a%/*}"} prefix=${prefix#/} max=32
		[[ $ip == *':'* ]] && max=128
		if [[ $a != *'/' && $prefix =~ ^(0|[1-9][0-9]{0,2})?$ ]] && (( ${prefix:-0} <= $max )) && { [[ $max == 128 && $ip =~ ^[0-9A-Fa-f:.]+$ ]] || Valid_IPv4 "$ip"; }
		then
			continue
		fi
		Fail "\"$a\" is not a valid network, e.g. 192.168.1.0/24 or fd42::/64."
		return 1
	done
}

Check_Endpoint()
{
	[[ $1 =~ ^[^[:blank:]]+:([1-9][0-9]{0,4})$ ]] && (( ${BASH_REMATCH[1]} <= 65535 )) && return 0
	Fail "\"$1\" is not a valid endpoint. Please use <host>:<port>, e.g. myserver.example.com:51820."
	return 1
}

Check_Keepalive()
{
	[[ $1 =~ ^[0-9]{0,5}$ ]] && (( 10#${1:-0} <= 65535 )) && return 0
	Fail "\"$1\" is not a valid keepalive interval. Allowed are 0 to 65535 seconds, or empty to disable it."
	return 1
}

# Check server settings, also called via Input_Checked. The port must not be used by another server than $IFACE.
Check_Port()
{
	if [[ ! $1 =~ ^[1-9][0-9]{0,4}$ ]] || (( $1 > 65535 ))
	then
		Fail "\"$1\" is not a valid port."
		return 1
	fi
	local i
	for i in "${SERVERS[@]}"
	do
		[[ $i != "$IFACE" && ${SRV_PORT[$i]} == "$1" ]] && { Fail "Port $1 is used by server $i already."; return 1; }
	done
	return 0
}

Check_Server_Address()
{
	local a
	[[ ${1//[ ,]/} ]] || { Fail 'The server address must not be empty.'; return 1; }
	for a in ${1//,/ }
	do
		[[ $a =~ ^[0-9.]+/[0-9]{1,2}$ ]] && Valid_IPv4 "${a%/*}" && (( ${a#*/} <= 30 )) && continue
		[[ $a =~ ^[0-9A-Fa-f:]+/[0-9]{1,3}$ ]] && continue
		Fail "\"$a\" is not a valid address with prefix length, e.g. 10.9.0.1/24 or fd42::1/64."
		return 1
	done
}

# Interface name for a new server, as allowed by wg-quick
Check_Iface()
{
	[[ $1 =~ ^[A-Za-z0-9_=+.-]{1,15}$ ]] || { Fail "\"$1\" is not a valid interface name. Allowed are up to 15 letters, digits, and _ = + . -"; return 1; }
	[[ ! -e $WG_DIR/$1.conf ]] || { Fail "$WG_DIR/$1.conf exists already."; return 1; }
	[[ ! -e /sys/class/net/$1 ]] || { Fail "A network interface $1 exists already."; return 1; }
}

# IPv6 address for a client, with the same host part as its IPv4 address, if the server has an IPv6 address and it is not used already
V6_For()
{
	V6=
	[[ $SRV6_IP && $SRV4_IP ]] || return 1
	Load_Used
	Ip2Int "$1"
	V6="${SRV6_IP%:*}:$(printf '%x' "$(( $INT - $SRV4_NET ))")"
	[[ $USED6 != *" ${V6,,} "* ]] && return 0
	V6=
	return 1
}

# Defaults for new clients from the newest client config of $IFACE
Load_Defaults()
{
	DEF_ENDPOINT='' DEF_DNS='' DEF_ALLOWED='' DEF_KEEPALIVE=''
	local c newest='' newest_time=0 t host
	for c in "${!C_FILE[@]}"
	do
		[[ ${C_IF[c]} == "$IFACE" && ${C_STATE[c]} != 'unused' ]] || continue
		t=$(stat -c '%Y' "${C_FILE[c]}")
		(( $t > $newest_time )) || continue
		newest=$c newest_time=$t
	done
	if [[ $newest ]]
	then
		Parse_Conf "${C_FILE[newest]}"
		DEF_DNS=${CONF_I[dns]} DEF_ALLOWED=${CONF_P[1,allowedips]} DEF_KEEPALIVE=${CONF_P[1,persistentkeepalive]}
		[[ ${CONF_P[1,endpoint]} ]] && host=${CONF_P[1,endpoint]%:*}
	else
		DEF_ALLOWED='0.0.0.0/0, ::/0'
		# Local DNS resolvers are reachable via the server VPN IP: https://github.com/MichaIng/DietPi/issues/2482
		DEF_DNS=$(mawk '/^[[:blank:]]*nameserver[[:blank:]]/{print $2;exit}' /etc/resolv.conf)
		[[ $DEF_DNS =~ ^(127\.|::1$|localhost$) ]] && DEF_DNS=$SRV4_IP
	fi
	[[ $host ]] || host=$(sed -n '/^[[:blank:]]*SOFTWARE_PUBLIC_DOMAIN_NAME=/{s/^[^=]*=//p;q}' /boot/dietpi.txt)
	[[ $host ]] || host=$(hostname -f)
	DEF_ENDPOINT="$host:${SRV_PORT[$IFACE]}"
}

Name_Exists()
{
	local c
	for c in "${!C_FILE[@]}"
	do
		[[ ${C_IF[c]} == "$IFACE" && ${C_NAME[c]} == "$1" ]] && return 0
	done
	[[ -e $CLIENT_DIR/$IFACE-$1.conf ]]
}

Check_Name()
{
	[[ $1 =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { Fail "\"$1\" is not a valid client name. Allowed are letters, digits, and _ . -"; return 1; }
	! Name_Exists "$1" || { Fail "A client with the name \"$1\" exists already for $IFACE."; return 1; }
}

# Like Check_Name, but keeping the current name $RENAME_FROM is accepted as well, called via Input_Checked
# shellcheck disable=SC2329
Check_Rename(){ [[ $1 == "$RENAME_FROM" ]] || Check_Name "$1"; }

#/////////////////////////////////////////////////////////////////////////////////////
# Changing configs
#/////////////////////////////////////////////////////////////////////////////////////
# Shared mawk code: store lines, detect section headers (hdr) and key/value lines (kk/vv), find a section by header and optional public key (bs = header line, be = last line before next header)
# shellcheck disable=SC2016
readonly AWK_LIB='
function scan(   i, t, p) {
	for (i = 1; i <= NR; i++) {
		t = line[i]; sub(/#.*/, "", t); gsub(/^[ \t]+|[ \t\r]+$/, "", t)
		if (t ~ /^\[/) { hdr[i] = tolower(t); continue }
		p = index(t, "=")
		if (t == "" || !p) continue
		kk[i] = tolower(substr(t, 1, p - 1)); gsub(/[ \t]+/, "", kk[i])
		vv[i] = substr(t, p + 1); sub(/^[ \t]+/, "", vv[i])
	}
}
function find(h, pub,   i, j, m) {
	for (i = 1; i <= NR; i++) {
		if (!(i in hdr) || hdr[i] != h) continue
		for (j = i + 1; j <= NR && !(j in hdr); j++);
		if (pub == "") { bs = i; be = j - 1; return 1 }
		for (m = i + 1; m < j; m++) if ((m in kk) && kk[m] == "publickey" && vv[m] == pub) { bs = i; be = j - 1; return 1 }
	}
	return 0
}
{ line[NR] = $0 }'

# Print config $1 with key $4 set to value $5 in section $2 (Interface or Peer), the latter matched by public key $3 if given. An empty value removes the key.
Conf_Set()
{
	mawk -v sec="[${2,,}]" -v pub="$3" -v key="$4" -v val="$5" "$AWK_LIB"'
	END {
		scan()
		if (!find(sec, pub)) exit 2
		last = bs
		for (m = bs + 1; m <= be; m++) if (m in kk) last = m
		lk = tolower(key)
		for (i = 1; i <= NR; i++) {
			if (i > bs && i <= be && (i in kk) && kk[i] == lk) {
				if (!done && val != "") { print key " = " val; done = 1 }
				continue
			}
			print line[i]
			if (i == last && !done && val != "") { print key " = " val; done = 1 }
		}
	}' "$1"
}

# Print config $1 without the [Peer] section with public key $2, and write that section to file $3. Comment lines directly above the section header belong to it, trailing comments are kept.
Conf_Cut()
{
	mawk -v pub="$2" -v out="$3" "$AWK_LIB"'
	END {
		scan()
		if (!find("[peer]", pub)) exit 2
		e = bs
		for (m = bs + 1; m <= be; m++) if (m in kk) e = m
		s = bs
		while (s > 1 && !((s - 1) in hdr) && line[s - 1] ~ /^[ \t]*#/) s--
		ds = s
		if (s > 1 && line[s - 1] ~ /^[ \t\r]*$/ && (e == NR || line[e + 1] ~ /^[ \t\r]*$/)) ds = s - 1
		for (i = 1; i <= NR; i++) {
			if (i >= s && i <= e) { print line[i] > out; continue }
			if (i >= ds && i < s) continue
			print line[i]
		}
	}' "$1"
}

# Print an empty line to separate a new section, and a newline first if the file does not end with one
Block_Separator()
{
	[[ -s $1 ]] || return 0
	[[ $(tail -c 1 "$1") ]] && echo
	echo
}

# Bring $IFACE up or down: $1 = up|down, via wg-quick@.service if $SERVICE = 1
Iface_Ctl()
{
	if (( $SERVICE ))
	then
		local action='start'
		[[ $1 == 'down' ]] && action='stop'
		G_EXEC_NOEXIT=1 G_EXEC systemctl "$action" "wg-quick@$IFACE"
	else
		G_EXEC_NOEXIT=1 G_EXEC wg-quick "$1" "$IFACE"
	fi
}

# Sync the running $IFACE with its config, without disconnecting unchanged peers
Iface_Sync()
{
	local tmp key result
	tmp=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") || return 1
	wg-quick strip "$IFACE" > "$tmp" || { rm -f "$tmp"; return 1; }
	# "wg syncconf" removes the private key if the config has none, e.g. when it is set via "PostUp = wg set %i private-key <file>", hence keep the current one
	if ! grep -qi '^[[:blank:]]*PrivateKey[[:blank:]]*=' "$tmp"
	then
		key=$(wg show "$IFACE" private-key)
		[[ $key && $key != '(none)' ]] && sed -i "/^[[:blank:]]*\[interface\]/I a PrivateKey = $key" "$tmp"
	fi
	G_EXEC_NOEXIT=1 G_EXEC wg syncconf "$IFACE" "$tmp"
	result=$?
	rm -f "$tmp"
	return "$result"
}

# Replace the server config of $IFACE with file $1 and apply it, if the interface is running. On failure, the previous config and interface state are restored.
# - $2 = 1 to restart the interface, else peers are synced without disconnecting others
Server_Commit()
{
	local new=$1 restart=${2:-0} conf="$WG_DIR/$IFACE.conf" backup="$WG_DIR/.$IFACE.conf.bak" up=0 SERVICE=0 result=1
	[[ -e /sys/class/net/$IFACE ]] && up=1
	systemctl -q is-active "wg-quick@$IFACE" && SERVICE=1
	G_EXEC cp -a "$conf" "$backup"
	# Stop before writing the config, as with "SaveConfig = true", wg-quick down overwrites it with the runtime state
	(( $restart && $up )) && Iface_Ctl down
	if cat "$new" > "$conf" && wg-quick strip "$IFACE" > /dev/null
	then
		if (( ! $up ))
		then
			result=0

		elif (( $restart ))
		then
			Iface_Ctl up && result=0
		else
			Iface_Sync && result=0
		fi
	fi
	rm -f "$new"
	(( $result )) || { G_EXEC rm "$backup"; return 0; }

	G_DIETPI-NOTIFY 1 "Applying the changed $conf failed, restoring the previous config"
	G_EXEC mv "$backup" "$conf"
	if (( $up && $restart ))
	then
		Iface_Ctl up

	elif (( $up ))
	then
		Iface_Sync
	fi
	Fail "Applying the changed $conf failed. The previous config has been restored."
}

# Write file $1 to $2 and remove $1. Remove $2 if nothing but comments and empty lines are left, used for <interface>.disabled.
File_Replace()
{
	cat "$1" > "$2" || { rm -f "$1"; return 1; }
	rm -f "$1"
	[[ $2 == *'.disabled' ]] && ! grep -q '^[[:blank:]]*[^#[:blank:]]' "$2" && G_EXEC rm "$2"
	return 0
}

# Add a peer to the server config of $IFACE: $1 = public key, $2 = AllowedIPs, $3 = PresharedKey
Peer_Add()
{
	local conf="$WG_DIR/$IFACE.conf" new
	new=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") || return 1
	{
		cat "$conf"
		Block_Separator "$conf"
		echo '[Peer]'
		echo "PublicKey = $1"
		[[ $3 ]] && echo "PresharedKey = $3"
		echo "AllowedIPs = $2"
	} > "$new"
	Server_Commit "$new"
}

# Set key $2 to value $3 in the server side section of peer $1
Peer_Set()
{
	local f="$WG_DIR/$IFACE.conf" tmp
	[[ ${P_STATE[$1]} == 'disabled' ]] && f="$WG_DIR/$IFACE.disabled"
	tmp=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") || return 1
	Conf_Set "$f" 'Peer' "${P_PUB[$1]}" "$2" "$3" > "$tmp" || { rm -f "$tmp"; Fail "Peer ${P_PUB[$1]} was not found in $f."; return 1; }
	if [[ ${P_STATE[$1]} == 'active' ]]
	then
		Server_Commit "$tmp"
	else
		File_Replace "$tmp" "$f"
	fi
}

# Move peer $1 between the server config and <interface>.disabled: $2 = target state
Peer_Move()
{
	local from="$WG_DIR/$IFACE.conf" to="$WG_DIR/$IFACE.disabled" rest block new
	[[ $2 == 'active' ]] && from="$WG_DIR/$IFACE.disabled" to="$WG_DIR/$IFACE.conf"
	rest=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") && block=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") && new=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") || return 1
	Conf_Cut "$from" "${P_PUB[$1]}" "$block" > "$rest" || { rm -f "$rest" "$block" "$new"; Fail "Peer ${P_PUB[$1]} was not found in $from."; return 1; }
	{ [[ -f $to ]] && cat "$to" && Block_Separator "$to"; cat "$block"; } > "$new"
	rm -f "$block"
	if [[ $2 == 'active' ]]
	then
		# Add to server config first, remove from disabled peers only on success
		Server_Commit "$new" || { rm -f "$rest"; return 1; }
		File_Replace "$rest" "$from"
	else
		Server_Commit "$rest" || { rm -f "$new"; return 1; }
		File_Replace "$new" "$to"
	fi
}

Peer_Remove()
{
	local f="$WG_DIR/$IFACE.conf" rest block
	[[ ${P_STATE[$1]} == 'disabled' ]] && f="$WG_DIR/$IFACE.disabled"
	rest=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") && block=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") || return 1
	Conf_Cut "$f" "${P_PUB[$1]}" "$block" > "$rest" || { rm -f "$rest" "$block"; Fail "Peer ${P_PUB[$1]} was not found in $f."; return 1; }
	rm -f "$block"
	if [[ ${P_STATE[$1]} == 'active' ]]
	then
		Server_Commit "$rest" || return 1
	else
		File_Replace "$rest" "$f" || return 1
	fi
	(( ${P_CLIENT[$1]} < 0 )) || G_EXEC rm "${C_FILE[${P_CLIENT[$1]}]}"
	G_DIETPI-NOTIFY 0 "Removed client ${P_NAME[$1]:-${P_PUB[$1]}}"
}

# Move client config $1 to /etc/wireguard/clients/<interface>-<name>.conf, if it is not there yet
Client_Migrate()
{
	local target="$CLIENT_DIR/$IFACE-${C_NAME[$1]}.conf"
	[[ ${C_FILE[$1]} == "$target" ]] && return 0
	[[ ! -e $target ]] || { Fail "${C_FILE[$1]} cannot be moved to $target, as the latter exists already."; return 1; }
	[[ -d $CLIENT_DIR ]] || G_EXEC mkdir -m 0700 "$CLIENT_DIR"
	G_EXEC mv "${C_FILE[$1]}" "$target"
	C_FILE[$1]=$target
}

# Set key $3 to value $4 in section $2 (Interface or Peer) of client config $1
Client_Set()
{
	local tmp
	Client_Migrate "$1" || return 1
	tmp=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") || return 1
	Conf_Set "${C_FILE[$1]}" "$2" '' "$3" "$4" > "$tmp" || { rm -f "$tmp"; Fail "Section [$2] was not found in ${C_FILE[$1]}."; return 1; }
	File_Replace "$tmp" "${C_FILE[$1]}"
}

Client_Rename()
{
	local target="$CLIENT_DIR/$IFACE-$2.conf"
	Check_Name "$2" || return 1
	[[ -d $CLIENT_DIR ]] || G_EXEC mkdir -m 0700 "$CLIENT_DIR"
	G_EXEC mv "${C_FILE[$1]}" "$target"
	C_FILE[$1]=$target C_NAME[$1]=$2
}

# Create a new client of $IFACE: $1 = name, $2 = IPv4 address, $3 = endpoint, $4 = DNS, $5 = AllowedIPs, $6 = keepalive, $7 = 1 for PresharedKey
Client_Create()
{
	local file="$CLIENT_DIR/$IFACE-$1.conf" priv pub psk='' address server_ips
	Check_Name "$1" && Check_Client_IP "$2" && Check_Endpoint "$3" && Check_AllowedIPs "$5" && Check_Keepalive "$6" || return 1
	[[ ${SRV_PUB[$IFACE]} ]] || { Fail "The public key of server $IFACE is unknown, as its config has no PrivateKey and the interface is not running."; return 1; }
	if ! priv=$(wg genkey) || ! pub=$(wg pubkey <<< "$priv")
	then
		Fail 'Generating the client keys failed.'
		return 1
	fi
	(( $7 )) && { psk=$(wg genpsk) || { Fail 'Generating the PresharedKey failed.'; return 1; }; }
	address="$2/$SRV4_PREFIX" server_ips="$2/32"
	V6_For "$2" && address+=", $V6/$SRV6_PREFIX" server_ips+=", $V6/128"

	# Write the client config first, so that no peer without client config and private key remains if this fails
	[[ -d $CLIENT_DIR ]] || G_EXEC mkdir -m 0700 "$CLIENT_DIR"
	{
		echo '[Interface]'
		echo "Address = $address"
		echo "PrivateKey = $priv"
		[[ $4 ]] && echo "DNS = $4"
		echo
		echo '[Peer]'
		echo "PublicKey = ${SRV_PUB[$IFACE]}"
		[[ $psk ]] && echo "PresharedKey = $psk"
		echo "AllowedIPs = $5"
		echo "Endpoint = $3"
		[[ $6 && $6 != 0 ]] && echo "PersistentKeepalive = $6"
		:
	} > "$file" || { rm -f "$file"; Fail "Writing $file failed."; return 1; }
	Peer_Add "$pub" "$server_ips" "$psk" || { G_EXEC rm "$file"; return 1; }
	G_DIETPI-NOTIFY 0 "Created client $1: $file"
}

# Add unused client config $1 as peer again
Client_Readd()
{
	local a ips='' i
	Load_Server_Net
	Parse_Conf "${C_FILE[$1]}"
	for a in ${CONF_I[address]//,/ }
	do
		a=${a%/*}
		if Valid_IPv4 "$a"
		then
			Ip2Int "$a"
			if [[ ! $SRV4_IP || $a == "$SRV4_IP" ]] || (( $INT <= $SRV4_NET || $INT >= $SRV4_BCAST ))
			then
				Fail "Address $a of ${C_FILE[$1]} is not a client address inside the server subnet $SRV4_IP/$SRV4_PREFIX."
				return 1
			fi
		fi
		[[ $a == *':'* ]] && a+='/128' || a+='/32'
		for i in "${!P_IPS[@]}"
		do
			[[ ", ${P_IPS[i]}, " == *", $a, "* ]] && { Fail "Address $a is used by another peer already."; return 1; }
		done
		ips+=${ips:+, }$a
	done
	[[ $ips ]] || { Fail "${C_FILE[$1]} has no Address."; return 1; }
	Peer_Add "${C_PUB[$1]}" "$ips" "${CONF_P[1,presharedkey]}"
}

# Enable ($2 = 1) or disable a PresharedKey for peer $1, on server and client side
Client_PSK()
{
	local psk=
	(( $2 )) && { psk=$(wg genpsk) || return 1; }
	Peer_Set "$1" 'PresharedKey' "$psk" || return 1
	# "wg syncconf" does not remove a PresharedKey from an existing peer
	[[ ! $psk && ${P_STATE[$1]} == 'active' && -e /sys/class/net/$IFACE ]] && { G_EXEC wg set "$IFACE" peer "${P_PUB[$1]}" preshared-key /dev/null || return 1; }
	(( ${P_CLIENT[$1]} < 0 )) || Client_Set "${P_CLIENT[$1]}" 'Peer' 'PresharedKey' "$psk"
}

# Defaults for a new server into $NEW_IFACE, $NEW_PORT and $NEW_ADDR, which are not used by other servers
Server_Defaults()
{
	local n=0
	while [[ -e $WG_DIR/wg$n.conf || -e /sys/class/net/wg$n ]]; do ((n++)); done
	NEW_IFACE="wg$n"
	NEW_PORT=$(sed -n '/^[[:blank:]]*SOFTWARE_WIREGUARD_PORT=/{s/^[^=]*=//p;q}' /boot/dietpi.txt)
	[[ $NEW_PORT =~ ^[1-9][0-9]{0,4}$ ]] && (( $NEW_PORT <= 65535 )) || NEW_PORT=51820
	while [[ " ${SRV_PORT[*]} " == *" $NEW_PORT "* ]]; do ((NEW_PORT++)); done
	n=9
	while [[ " ${SRV_ADDR[*]//,/ } " == *" 10.$n."* ]]; do ((n++)); done
	NEW_ADDR="10.$n.0.1/24"
}

# Create a new server config with hooks to forward and masquerade client traffic, then enable and start it: $1 = interface, $2 = listen port, $3 = address(es)
Server_Create()
{
	local conf="$WG_DIR/$1.conf" key net
	Check_Iface "$1" && Check_Port "$2" && Check_Server_Address "$3" || return 1
	Parse_Net "$3"
	[[ $NET4_IP ]] || { Fail 'The server needs an IPv4 address, whose subnet is used for the clients.'; return 1; }
	Int2Ip "$NET4_NET"
	net="$IP/$NET4_PREFIX"

	# The hooks use iptables. Install it with the default umask, like the packages in the main part.
	umask 0022
	G_AG_CHECK_INSTALL_PREREQ iptables
	umask 0077
	[[ -d $WG_DIR ]] || G_EXEC mkdir -m 0700 "$WG_DIR"

	# Re-use the server key of old dietpi-software installs, so that existing clients keep working
	if [[ $1 == 'wg0' && -f $WG_DIR/server_private.key ]] && key=$(<"$WG_DIR/server_private.key") && Pubkey "$key" && [[ $PUBKEY ]]
	then
		G_DIETPI-NOTIFY 2 "Re-using the server key from $WG_DIR/server_private.key"
	else
		key=$(wg genkey) || { Fail 'Generating the server key failed.'; return 1; }
	fi
	cat << _EOF_ > "$conf" || { rm -f "$conf"; Fail "Writing $conf failed."; return 1; }
[Interface]
Address = $3
PrivateKey = $key
ListenPort = $2

PostUp = sysctl net.ipv4.conf.%i.forwarding=1 net.ipv4.conf.\$(ip r l 0/0 | mawk '{print \$5;exit}').forwarding=1
PostUp = sysctl net.ipv6.conf.\$(ip r l 0/0 | mawk '{print \$5;exit}').accept_ra=2
PostUp = sysctl net.ipv6.conf.%i.forwarding=1 net.ipv6.conf.\$(ip r l 0/0 | mawk '{print \$5;exit}').forwarding=1
PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -t nat -A POSTROUTING -s $net -o \$(ip r l 0/0 | mawk '{print \$5;exit}') -j MASQUERADE
PostUp = ip6tables -A FORWARD -i %i -j ACCEPT; ip6tables -t nat -A POSTROUTING -o \$(ip r l 0/0 | mawk '{print \$5;exit}') -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -t nat -D POSTROUTING -s $net -o \$(ip r l 0/0 | mawk '{print \$5;exit}') -j MASQUERADE
PostDown = ip6tables -D FORWARD -i %i -j ACCEPT; ip6tables -t nat -D POSTROUTING -o \$(ip r l 0/0 | mawk '{print \$5;exit}') -j MASQUERADE
_EOF_
	wg-quick strip "$conf" > /dev/null || { G_EXEC rm "$conf"; Fail "The created config $conf is invalid."; return 1; }
	G_DIETPI-NOTIFY 0 "Created server $1: $conf"
	# The config exists now, hence report a failed start with return code 2, so that it is shown in the main menu
	G_EXEC_NOEXIT=1 G_EXEC systemctl enable --now "wg-quick@$1" || { Fail "Server $1 has been created, but starting it failed."; return 2; }
	G_DIETPI-NOTIFY 0 "Server $1 listens on port $2. Please forward this UDP port from your router to this server, if it is behind NAT."
}

Server_Set_Port()
{
	local port=$1 old=${SRV_PORT[$IFACE]} tmp c update=()
	Check_Port "$port" || return 1
	[[ $port == "$old" ]] && return 0
	tmp=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") || return 1
	Conf_Set "$WG_DIR/$IFACE.conf" 'Interface' '' 'ListenPort' "$port" > "$tmp" || { rm -f "$tmp"; return 1; }
	Server_Commit "$tmp" || return 1
	SRV_PORT[$IFACE]=$port
	G_DIETPI-NOTIFY 0 "Server $IFACE listens on port $port now. Please adjust port forwarding and firewall rules, if required."

	# Unused client configs as well, so that they work when being re-added
	for c in "${!C_FILE[@]}"
	do
		[[ ${C_IF[c]} == "$IFACE" ]] || continue
		Parse_Conf "${C_FILE[c]}"
		[[ ${CONF_P[1,endpoint]} == *":$old" ]] && update+=("$c")
	done
	(( ${#update[@]} )) || return 0
	Confirm "Update the endpoint port from $old to $port in ${#update[@]} client config(s)?\n\nClient devices need to import their config again afterwards, e.g. by scanning the QR code." || return 0
	# The server has been changed already: report failures with return code 2, so that the input is not asked again
	local failed=0
	for c in "${update[@]}"
	do
		Parse_Conf "${C_FILE[c]}"
		Client_Set "$c" 'Peer' 'Endpoint' "${CONF_P[1,endpoint]%:*}:$port" || failed=1
	done
	(( $failed )) && { Fail "Server $IFACE listens on port $port now, but not all client configs could be updated."; return 2; }
	return 0
}

# Change the server address. If the IPv4 subnet changes, peers and client configs are moved to the new subnet, keeping their host part.
Server_Set_Address()
{
	local new=$1 a tmp tmp2 i c ips entry old_net='' new_net='' renumber=0 moved=0 o_mask
	Check_Server_Address "$new" || return 1
	[[ ${new// /} == "${SRV_ADDR[$IFACE]// /}" ]] && return 0
	Load_Server_Net
	local o_ip=$SRV4_IP o_prefix=$SRV4_PREFIX o_net=$SRV4_NET
	Parse_Net "$new"
	local n_ip=$NET4_IP n_prefix=$NET4_PREFIX n_net=$NET4_NET n_bcast=$NET4_BCAST

	# Map IPv4 host addresses of peers and unused client configs from the old subnet to the new one, and check that the new server IP is not used by a client
	local -A map=() clients=()
	local addresses=()
	for i in "${!P_IPS[@]}"
	do
		for a in ${P_IPS[i]//,/ }
		do
			[[ $a == *'/32' ]] && addresses+=("${a%/32}")
		done
	done
	for c in "${!C_FILE[@]}"
	do
		[[ ${C_IF[c]} == "$IFACE" && ${C_STATE[c]} == 'unused' ]] || continue
		for a in ${C_ADDR[c]//,/ }
		do
			addresses+=("${a%/*}")
		done
	done
	if [[ $o_ip && $n_ip ]]
	then
		(( $o_net != $n_net || $o_prefix != $n_prefix )) && renumber=1
		o_mask=$(( (0xFFFFFFFF << (32 - $o_prefix)) & 0xFFFFFFFF ))
		for a in "${addresses[@]}"
		do
			Valid_IPv4 "$a" || continue
			Ip2Int "$a"
			if (( $renumber && ($INT & $o_mask) == $o_net ))
			then
				(( $INT - $o_net < $n_bcast - $n_net )) || { Fail "Client address $a does not fit into the new subnet $n_ip/$n_prefix."; return 1; }
				Int2Ip "$(( $n_net + $INT - $o_net ))"
				map[$a]=$IP
				((moved++))
				a=$IP
			fi
			clients[$a]=1
		done
		[[ ${clients[$n_ip]} ]] && { Fail "$n_ip is used by a client already."; return 1; }
		Int2Ip "$o_net"
		old_net="$IP/$o_prefix"
		Int2Ip "$n_net"
		new_net="$IP/$n_prefix"
	fi

	if (( $renumber ))
	then
		Confirm "The IPv4 subnet changes from $old_net to $new_net:
- $moved client(s) are moved to the new subnet, keeping their host part. Their server peer and client config Address are adjusted.
- DNS entries in client configs pointing to $o_ip are changed to $n_ip.
- \"$old_net\" in PreUp/PostUp/PreDown/PostDown lines and in client AllowedIPs is replaced with \"$new_net\".
- IPv6 addresses of clients are not changed.
\nThe interface is restarted, and client devices need to import their config again, e.g. by scanning the QR code.\n\nContinue?" || return 0
	else
		Confirm "Change the server address to $new?\n\nThe interface is restarted.${o_ip:+ DNS entries in client configs pointing to $o_ip are changed to ${n_ip:-none}.}" || return 0
	fi

	# Server config: Address, active peers and subnet in hook commands
	tmp=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") && tmp2=$(mktemp "$G_WORKING_DIR/tmp.XXXXXX") || return 1
	Conf_Set "$WG_DIR/$IFACE.conf" 'Interface' '' 'Address' "$new" > "$tmp" || { rm -f "$tmp" "$tmp2"; return 1; }
	(( $renumber )) && sed -Ei "/^[[:blank:]]*(Pre|Post)(Up|Down)[[:blank:]]*=/s#${old_net//./\\.}#$new_net#g" "$tmp"
	for i in "${!P_IPS[@]}"
	do
		[[ ${P_STATE[i]} == 'active' ]] || continue
		Map_IPs "${P_IPS[i]}"
		[[ $IPS == "${P_IPS[i]}" ]] && continue
		Conf_Set "$tmp" 'Peer' "${P_PUB[i]}" 'AllowedIPs' "$IPS" > "$tmp2" && cat "$tmp2" > "$tmp"
	done
	rm -f "$tmp2"
	Server_Commit "$tmp" 1 || return 1
	SRV_ADDR[$IFACE]=$new

	# The server has been changed now: update everything else, and report failures with return code 2, so that the input is not asked again
	local failed=0

	# Disabled peers
	for i in "${!P_IPS[@]}"
	do
		[[ ${P_STATE[i]} == 'disabled' ]] || continue
		Map_IPs "${P_IPS[i]}"
		[[ $IPS == "${P_IPS[i]}" ]] || Peer_Set "$i" 'AllowedIPs' "$IPS" || failed=1
	done

	# Client configs, including unused ones: Address, AllowedIPs and DNS
	for c in "${!C_FILE[@]}"
	do
		[[ ${C_IF[c]} == "$IFACE" ]] || continue
		Parse_Conf "${C_FILE[c]}"
		ips=
		for a in ${CONF_I[address]//,/ }
		do
			entry=$a
			[[ ${map[${a%/*}]} ]] && entry="${map[${a%/*}]}/$n_prefix"
			ips+=${ips:+, }$entry
		done
		[[ $ips == "${CONF_I[address]}" ]] || Client_Set "$c" 'Interface' 'Address' "$ips" || { failed=1; continue; }
		if (( $renumber )) && [[ ", ${CONF_P[1,allowedips]}, " == *", $old_net, "* ]]
		then
			entry=", ${CONF_P[1,allowedips]}, "
			entry=${entry//, $old_net, /, $new_net, }
			entry=${entry#, } entry=${entry%, }
			Client_Set "$c" 'Peer' 'AllowedIPs' "$entry" || { failed=1; continue; }
		fi
		[[ $o_ip && $o_ip != "$n_ip" && ", ${CONF_I[dns]}, " == *", $o_ip, "* ]] || continue
		entry=", ${CONF_I[dns]}, "
		entry=${entry//, $o_ip, /${n_ip:+, $n_ip}, }
		entry=${entry#, } entry=${entry%, }
		Client_Set "$c" 'Interface' 'DNS' "$entry" || failed=1
	done
	(( $failed )) && { Fail "Server $IFACE uses address $new now, but not all client configs could be updated."; return 2; }
	G_DIETPI-NOTIFY 0 "Server $IFACE uses address $new now"
}

# Apply the IPv4 address map of Server_Set_Address to an AllowedIPs list into $IPS
Map_IPs()
{
	local a
	IPS=
	for a in ${1//,/ }
	do
		[[ $a == *'/32' && ${map[${a%/32}]} ]] && a="${map[${a%/32}]}/32"
		IPS+=${IPS:+, }$a
	done
}

# Files not needed anymore: key files which contain keys that are stored in configs already into KEY_FILES, plus unused client configs of all servers into CLEANUP_FILES
Load_Cleanup()
{
	KEY_FILES=()
	local c f key
	shopt -s nullglob
	for f in "$WG_DIR"/*.key
	do
		key=$(<"$f")
		key=${key//[[:space:]]/}
		[[ $key && ${KNOWN_KEYS[$key]} ]] && KEY_FILES+=("$f")
	done
	shopt -u nullglob
	CLEANUP_FILES=("${KEY_FILES[@]}")
	for c in "${!C_FILE[@]}"
	do
		[[ ${C_STATE[c]} == 'unused' ]] && CLEANUP_FILES+=("${C_FILE[c]}")
	done
}

# Print client config $1 as QR code, without comments and empty lines
Show_QR()
{
	local qr lines
	qr=$(sed -E 's/[[:blank:]]*#.*$//; /^[[:blank:]]*$/d' "$1" | qrencode -t ansiutf8) || { Fail 'Generating the QR code failed.'; return 1; }
	(( $MENU )) && G_TERM_CLEAR
	echo "$qr"
	(( $MENU )) || return 0
	lines=$(wc -l <<< "$qr")
	(( $lines * 2 > $(tput cols) || $lines + 3 > $(tput lines) )) && G_DIETPI-NOTIFY 2 'The QR code might not fit into this terminal. If it cannot be scanned, please enlarge the window or reduce the font size.'
	read -rp " - Scan the QR code of client \"$2\" with the WireGuard app, then press Enter to return ..."
}

#/////////////////////////////////////////////////////////////////////////////////////
# Menus
