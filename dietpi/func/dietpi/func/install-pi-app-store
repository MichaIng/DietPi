#!/bin/bash
# DietPi fork first-run integration. DietPi GPL licensing remains unchanged.
# Pins reviewed installer and program bytes. No desktop or account login.
Install_Pi_App_Store()
{
 local store_commit=9b06fce93257722c4062e6e60fae1a9433314ac8
 local installer_sha=4e27bb1417037607a65cedcccdb19d71e874955ae0cb133a61a93271896d8eab
 local program_sha=c5b1fc4890f125f9559ac3d4340b4f361ecc6bd9d78107d47af6dff21565a2a5
 local work status=0
 (( EUID == 0 )) || { echo 'Pi App Store first-run install requires root.'; return 1; }
 if command -v appstore &>/dev/null
 then
  G_DIETPI-NOTIFY 2 'An appstore command already exists. Leaving it unchanged.'
  return 0
 fi
 G_DIETPI-NOTIFY 2 'Installing the fork Pi App Store (pinned reviewed release), no desktop required.'
 G_EXEC_NOHALT=1 G_AGI python3 wget || return 1
 work=$(mktemp -d) || return 1
 if ! wget --tries=1 --timeout=30 -q -O "$work/install.sh" "https://raw.githubusercontent.com/Greenisus1/pi-app-store/$store_commit/install.sh" ||
    ! wget --tries=1 --timeout=30 -q -O "$work/appstore.py" "https://raw.githubusercontent.com/Greenisus1/pi-app-store/$store_commit/appstore.py"
 then
  G_DIETPI-NOTIFY 1 'Pi App Store download failed. OS setup will continue; retry manually later.'
  status=1
 elif ! (cd "$work" && printf '%s  %s\n' "$installer_sha" install.sh "$program_sha" appstore.py > SHA256SUMS && sha256sum -c SHA256SUMS)
 then
  G_DIETPI-NOTIFY 1 'Pi App Store checksum mismatch. Nothing executed; OS setup will continue.'
  status=1
 elif ! G_EXEC_NOHALT=1 G_EXEC env HOME=/root bash "$work/install.sh" --local
 then
  G_DIETPI-NOTIFY 1 'Pi App Store install failed. OS setup will continue; retry manually later.'
  status=1
 else
  G_DIETPI-NOTIFY 0 'Pi App Store installed for root. Run appstore; no desktop needed.'
 fi
 rm -rf -- "$work"
 return "$status"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]
then
 . /boot/dietpi/func/dietpi-globals || exit 1
 Install_Pi_App_Store
fi
