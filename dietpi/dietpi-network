			(( $CURRENT_IFACE_HOTSPOT_ACTIVE )) && hotspot_state_text='[On] | Select to turn off hotspot'
			local hotspot_n_text='Off' hotspot_ac_text='Off' hotspot_ax_text='Off' hotspot_freq_text='2.4' hotspot_channel_text=$HOTSPOT_CHANNEL
			(( $HOTSPOT_WIFI4 )) && hotspot_n_text='On'
			(( $HOTSPOT_WIFI5 )) && hotspot_ac_text='On'
			(( $HOTSPOT_WIFI6 )) && hotspot_ax_text='On'
