Error(){ G_DIETPI-NOTIFY 1 "$1"; exit 1; }

Trim(){ local value=$1; value=${value##[[:blank:]]}; value=${value%%[[:blank:]]}; echo "$value"; }

Mask_From_CIDR()
{
	local i mask='' full_octets=$(( $1 / 8 )) partial_octet=$(( $1 % 8 ))
	for i in {0..3}
	do
		if (( $i < $full_octets ))
		then
			mask+='255'
		elif (( $i == $full_octets && $partial_octet ))
		then
			mask+=$(( 256 - 2 ** ( 8 - $partial_octet ) ))
		else
			mask+='0'
		fi
		(( $i < 3 )) && mask+=.
	done
	echo "$mask"
}

Get_Default_DNS()
{
	local dns=$(mawk '$1=="nameserver"{print $2}' ORS=' ' /etc/resolv.conf 2> /dev/null)
	dns=${dns% }
	echo "${dns:-9.9.9.9 149.112.112.112}"
}

Get_Interfaces()
{
	ETH_INTERFACES=()
	WIFI_INTERFACES=()
	local iface path
	for path in /sys/class/net/*
	do
		[[ -e $path ]] || continue
		iface=${path##*/}
		[[ $iface == 'lo' ]] && continue
		if [[ -d $path/wireless ]]
		then
			WIFI_INTERFACES+=("$iface")
		# Physical VPN/tunnel/bridge/veth devices are excluded naturally since they lack a backing /sys/class/net/<iface>/device path.
		elif [[ -e $path/device ]]
		then
			ETH_INTERFACES+=("$iface")
		fi
	done
}

Interface_Is_Wifi(){ [[ -d /sys/class/net/$1/wireless ]]; }
Interface_Has_Hardware(){ [[ -e /sys/class/net/$1/device || -d /sys/class/net/$1/wireless ]]; }
Wifi_Modules_Enabled(){ [[ ! -f '/etc/modprobe.d/dietpi-disable_wifi.conf' ]]; }
Onboard_Wifi_Enabled(){ [[ ! -f '/boot/firmware/config.txt' ]] || ! grep -q '^[[:blank:]]*dtoverlay=disable-wifi' /boot/firmware/config.txt; }
Onboard_Wifi_Text(){ Onboard_Wifi_Enabled && echo 'On' || echo 'Off'; }
Current_Interface_Type_Text(){ [[ $CURRENT_IFACE_TYPE == 'wifi' ]] && echo 'WiFi' || echo 'Ethernet'; }

Net_Update_UsageStats()
{
	NET_RX_BYTE=0
	NET_TX_BYTE=0
	NET_RX_MB='N/A'
	NET_TX_MB='N/A'
	[[ -f /sys/class/net/$1/statistics/rx_bytes && -f /sys/class/net/$1/statistics/tx_bytes ]] || return
	read -r NET_RX_BYTE < "/sys/class/net/$1/statistics/rx_bytes"
	disable_error=1 G_CHECK_VALIDINT "$NET_RX_BYTE" 1 && NET_RX_MB="$(( $NET_RX_BYTE / 1024 / 1024 )) MiB"
	read -r NET_TX_BYTE < "/sys/class/net/$1/statistics/tx_bytes"
	disable_error=1 G_CHECK_VALIDINT "$NET_TX_BYTE" 1 && NET_TX_MB="$(( $NET_TX_BYTE / 1024 / 1024 )) MiB"
}

Load_Proxy_Vars()
{
	[[ $http_proxy ]] || http_proxy=
	if [[ -f '/etc/bashrc.d/dietpi-proxy.sh' ]]
	then
		PROXY_ENABLED=1
		# shellcheck disable=SC1091
		. /etc/bashrc.d/dietpi-proxy.sh
	else
		PROXY_ENABLED=0
	fi

	if [[ $http_proxy ]]
	then
		PROXY_ADDRESS=${http_proxy#*//}; PROXY_ADDRESS=${PROXY_ADDRESS%:*}
		PROXY_PORT=${http_proxy##*:}
		if [[ $http_proxy == *'@'* ]]
		then
			PROXY_ADDRESS=${PROXY_ADDRESS#*@}
			PROXY_USERNAME=${http_proxy#*//}; PROXY_USERNAME=${PROXY_USERNAME%%:*}
			PROXY_PASSWORD=${http_proxy%%@*}; PROXY_PASSWORD=${PROXY_PASSWORD##*:}
		fi
	else
		PROXY_ADDRESS=$(sed -n '/^[[:blank:]]*CONFIG_PROXY_ADDRESS=/{s/^[^=]*=//p;q}' /boot/dietpi.txt)
		PROXY_PORT=$(sed -n '/^[[:blank:]]*CONFIG_PROXY_PORT=/{s/^[^=]*=//p;q}' /boot/dietpi.txt)
		PROXY_USERNAME=$(sed -n '/^[[:blank:]]*CONFIG_PROXY_USERNAME=/{s/^[^=]*=//p;q}' /boot/dietpi.txt)
		PROXY_PASSWORD=$(sed -n '/^[[:blank:]]*CONFIG_PROXY_PASSWORD=/{s/^[^=]*=//p;q}' /boot/dietpi.txt)
	fi
}

Apply_Proxy_Settings()
{
	G_CONFIG_INJECT 'CONFIG_PROXY_ADDRESS=' "CONFIG_PROXY_ADDRESS=$PROXY_ADDRESS" /boot/dietpi.txt
	G_CONFIG_INJECT 'CONFIG_PROXY_PORT=' "CONFIG_PROXY_PORT=$PROXY_PORT" /boot/dietpi.txt
	G_CONFIG_INJECT 'CONFIG_PROXY_USERNAME=' "CONFIG_PROXY_USERNAME=$PROXY_USERNAME" /boot/dietpi.txt
	G_CONFIG_INJECT 'CONFIG_PROXY_PASSWORD=' "CONFIG_PROXY_PASSWORD=$PROXY_PASSWORD" /boot/dietpi.txt

	if (( $PROXY_ENABLED ))
	then
		G_EXEC mkdir -p /etc/bashrc.d
		if [[ $PROXY_USERNAME && $PROXY_PASSWORD ]]
		then
			echo "export {http,https,ftp}_proxy='******$PROXY_ADDRESS:$PROXY_PORT'" > /etc/bashrc.d/dietpi-proxy.sh
		else
			echo "export {http,https,ftp}_proxy='http://$PROXY_ADDRESS:$PROXY_PORT'" > /etc/bashrc.d/dietpi-proxy.sh
		fi
	else
		[[ ! -f '/etc/bashrc.d/dietpi-proxy.sh' ]] || G_EXEC rm /etc/bashrc.d/dietpi-proxy.sh
		unset -v {http,https,ftp}_proxy
	fi
}

Parse_Interface_Config()
{
	local file=$1 iface=$2 data
	[[ -f $file ]] || return 1
	data=$(mawk -v iface="$iface" '
		BEGIN{OFS="\034"}
		function top(line){return line ~ /^[[:blank:]]*(iface|auto|allow-hotplug|mapping|source)([[:blank:]]|$)/}
		{
			if (inblock && top($0)) inblock=0
			if ($0 ~ "^[[:blank:]]*(allow-hotplug|auto)[[:blank:]]+" iface "([[:blank:]]|$)") {enabled=1; found=1}
			if ($1=="iface" && $2==iface) {inblock=1; found=1; mode=$4; next}
			if (!inblock) next
			if ($1=="address") address=$2
			else if ($1=="netmask") netmask=$2
			else if ($1=="gateway") gateway=$2
			else if ($1=="dns-nameservers") {dns=""; for(i=2;i<=NF;i++) dns=dns (dns?" ":"") $i}
			else if (($1=="up" || $1=="pre-up" || $1=="post-down") && index($0,"iptables-restore")) hotspot=1
		}
		END{print found,enabled,mode,address,netmask,gateway,dns,hotspot}
	' "$file") || return 1
	IFS=$'\034' read -r PARSE_FOUND PARSE_ENABLED PARSE_MODE PARSE_ADDRESS PARSE_NETMASK PARSE_GATEWAY PARSE_DNS PARSE_HOTSPOT <<< "$data"
	return 0
}

Get_Interface_Stored_Settings()
{
	local iface=$1 type=$2
	CURRENT_IFACE_SOURCE=
	CURRENT_IFACE_ENABLED=1
	CURRENT_IFACE_MODE='dhcp'
	CURRENT_IFACE_MODE_TARGET='dhcp'
	CURRENT_IFACE_IP_STATIC=$([[ $type == 'wifi' ]] && echo '192.168.0.100' || echo '192.168.0.100')
	CURRENT_IFACE_MASK_STATIC='255.255.255.0'
	CURRENT_IFACE_GATEWAY_STATIC='192.168.0.1'
	CURRENT_IFACE_DNS_STATIC=$(Get_Default_DNS)

	if Parse_Interface_Config "/etc/network/interfaces.d/$iface.conf" "$iface" && [[ $PARSE_FOUND == 1 ]]
	then
		CURRENT_IFACE_SOURCE="/etc/network/interfaces.d/$iface.conf"
	elif Parse_Interface_Config '/etc/network/interfaces' "$iface" && [[ $PARSE_FOUND == 1 ]]
	then
		CURRENT_IFACE_SOURCE='/etc/network/interfaces'
	else
		return 0
	fi

	CURRENT_IFACE_ENABLED=${PARSE_ENABLED:-0}
	[[ $PARSE_MODE == 'static' ]] && CURRENT_IFACE_MODE='static' || CURRENT_IFACE_MODE='dhcp'
	CURRENT_IFACE_MODE_TARGET=$CURRENT_IFACE_MODE
	[[ $PARSE_ADDRESS ]] && CURRENT_IFACE_IP_STATIC=$PARSE_ADDRESS
	[[ $PARSE_NETMASK ]] && CURRENT_IFACE_MASK_STATIC=$PARSE_NETMASK
	[[ $PARSE_GATEWAY ]] && CURRENT_IFACE_GATEWAY_STATIC=$PARSE_GATEWAY
	[[ $PARSE_DNS ]] && CURRENT_IFACE_DNS_STATIC=$PARSE_DNS
	(( ${PARSE_HOTSPOT:-0} )) && CURRENT_IFACE_HOTSPOT=1
}

Load_Hotspot_Settings()
{
	HOTSPOT_SSID=$(sed -n '/^[[:blank:]]*ssid=/{s/^[^=]*=//p;q}' /etc/hostapd/hostapd.conf 2> /dev/null)
	HOTSPOT_KEY=$(sed -n '/^[[:blank:]]*wpa_passphrase=/{s/^[^=]*=//p;q}' /etc/hostapd/hostapd.conf 2> /dev/null)
	HOTSPOT_WIFI4=$(grep -cm1 '^[[:blank:]]*ieee80211n=1$' /etc/hostapd/hostapd.conf 2> /dev/null)
	HOTSPOT_WIFI5=$(grep -cm1 '^[[:blank:]]*ieee80211ac=1$' /etc/hostapd/hostapd.conf 2> /dev/null)
	HOTSPOT_WIFI6=$(grep -cm1 '^[[:blank:]]*ieee80211ax=1$' /etc/hostapd/hostapd.conf 2> /dev/null)
	HOTSPOT_5G=$(grep -cm1 '^[[:blank:]]*hw_mode=a$' /etc/hostapd/hostapd.conf 2> /dev/null)
	if (( $HOTSPOT_5G ))
	then
		HOTSPOT_5G_CHANNEL=$(sed -n '/^[[:blank:]]*channel=/{s/^[^=]*=//p;q}' /etc/hostapd/hostapd.conf 2> /dev/null)
		[[ $HOTSPOT_5G_CHANNEL ]] || HOTSPOT_5G_CHANNEL=$(sed -n '/^[[:blank:]]*SOFTWARE_WIFI_HOTSPOT_5G_CHANNEL=/{s/^[^=]*=//p;q}' /boot/dietpi.txt)
		[[ $HOTSPOT_5G_CHANNEL ]] || HOTSPOT_5G_CHANNEL=36
	else
		HOTSPOT_CHANNEL=$(sed -n '/^[[:blank:]]*channel=/{s/^[^=]*=//p;q}' /etc/hostapd/hostapd.conf 2> /dev/null)
		[[ $HOTSPOT_CHANNEL ]] || HOTSPOT_CHANNEL=$(sed -n '/^[[:blank:]]*SOFTWARE_WIFI_HOTSPOT_CHANNEL=/{s/^[^=]*=//p;q}' /boot/dietpi.txt)
		[[ $HOTSPOT_CHANNEL ]] || HOTSPOT_CHANNEL=3
	fi
	[[ $HOTSPOT_SSID ]] || HOTSPOT_SSID='DietPi-Hotspot'
	[[ $HOTSPOT_KEY ]] || HOTSPOT_KEY='dietpihotspot'
}

Load_Interface_State()
{
	local iface=$1
	CURRENT_IFACE=$iface
	if Interface_Is_Wifi "$iface"
	then
		CURRENT_IFACE_TYPE='wifi'
	else
		CURRENT_IFACE_TYPE='eth'
	fi
	Interface_Has_Hardware "$iface" && CURRENT_IFACE_HARDWARE=1 || CURRENT_IFACE_HARDWARE=0
	CURRENT_IFACE_CONNECTED=0
	CURRENT_IFACE_IP='0.0.0.0'
	CURRENT_IFACE_MASK='0.0.0.0'
	CURRENT_IFACE_GATEWAY='0.0.0.0'
	CURRENT_IFACE_WIFI_SSID='Disconnected / No SSID'
	CURRENT_IFACE_WIFI_BITRATE=0
	CURRENT_IFACE_WIFI_SIGNAL='N/A'
	CURRENT_IFACE_WIFI_AUTO_RECONNECT=0
	CURRENT_IFACE_HOTSPOT=0
	CURRENT_IFACE_HOTSPOT_ACTIVE=0
	DNS_CURRENT=$(Get_Default_DNS)
	Get_Interface_Stored_Settings "$iface" "$CURRENT_IFACE_TYPE"

	if (( $CURRENT_IFACE_HARDWARE ))
	then
		CURRENT_IFACE_CONNECTED=$(ip -o r l dev "$iface" 2> /dev/null | grep -vcm1 '[[:blank:]]linkdown')
		if (( $CURRENT_IFACE_CONNECTED ))
		then
			CURRENT_IFACE_IP=$(ip -br -f inet a s "$iface" 2> /dev/null | mawk '{print $3}' | sed 's|/.*$||')
			CURRENT_IFACE_GATEWAY=$(ip r l dev "$iface" 0/0 2> /dev/null | mawk '{print $3;exit}')
			local cidr=$(ip -br -f inet a s "$iface" 2> /dev/null | mawk '{print $3}' | sed 's|^.*/||')
			[[ $cidr ]] && CURRENT_IFACE_MASK=$(Mask_From_CIDR "$cidr")
		fi
	fi

	if [[ $CURRENT_IFACE_TYPE == 'wifi' ]]
	then
		# Only the WiFi interface referenced by hostapd can expose the single global hotspot configuration.
		[[ -f '/etc/hostapd/hostapd.conf' ]] && grep -q "^[[:blank:]]*interface=$iface$" /etc/hostapd/hostapd.conf && CURRENT_IFACE_HOTSPOT=1
		if (( $CURRENT_IFACE_CONNECTED ))
		then
			CURRENT_IFACE_WIFI_SSID=$(iw dev "$iface" link 2> /dev/null | mawk '$1=="SSID:"{print $2;exit}')
			[[ $CURRENT_IFACE_WIFI_SSID ]] || CURRENT_IFACE_WIFI_SSID='Disconnected / No SSID'
			CURRENT_IFACE_WIFI_BITRATE=$(iw dev "$iface" link 2> /dev/null | mawk '$1$2=="txbitrate:"{print $3;exit}')
			[[ $CURRENT_IFACE_WIFI_BITRATE ]] || CURRENT_IFACE_WIFI_BITRATE=0
			local signal=$(iw dev "$iface" link 2> /dev/null | mawk '$1=="signal:"{print $2;exit}')
			if disable_error=1 G_CHECK_VALIDINT "$signal" -500 -1
			then
				CURRENT_IFACE_WIFI_SIGNAL="$signal dBm"
			elif [[ $signal ]]
			then
				CURRENT_IFACE_WIFI_SIGNAL="$signal %"
			fi
		fi
		systemctl -q is-active dietpi-wifi-monitor && CURRENT_IFACE_WIFI_AUTO_RECONNECT=1 || CURRENT_IFACE_WIFI_AUTO_RECONNECT=0
		if (( $CURRENT_IFACE_HOTSPOT ))
		then
			Load_Hotspot_Settings
			systemctl -q is-active hostapd && CURRENT_IFACE_HOTSPOT_ACTIVE=1 || CURRENT_IFACE_HOTSPOT_ACTIVE=0
		fi
		CURRENT_WIFI_COUNTRYCODE=$(sed -n '/^[[:blank:]]*country_code=/{s/^[^=]*=//p;q}' /etc/hostapd/hostapd.conf 2> /dev/null)
		[[ $CURRENT_WIFI_COUNTRYCODE ]] || CURRENT_WIFI_COUNTRYCODE=$(sed -n '/^[[:blank:]]*country=/{s/^[^=]*=//p;q}' /etc/wpa_supplicant/wpa_supplicant.conf 2> /dev/null)
		[[ $CURRENT_WIFI_COUNTRYCODE ]] || command -v iw > /dev/null && CURRENT_WIFI_COUNTRYCODE=$(iw reg get 2> /dev/null | mawk -F'[ :]' '/country/{print $2;exit}')
		[[ $CURRENT_WIFI_COUNTRYCODE ]] || CURRENT_WIFI_COUNTRYCODE='00'
	fi
}

Remove_Interface_From_Main_File()
{
	local iface=$1 source='/etc/network/interfaces' target='/etc/network/.dietpi-network.interfaces.tmp'
	[[ -f $source ]] || return 0
	awk -v iface="$iface" '
		function top(line){return line ~ /^[[:blank:]]*(iface|auto|allow-hotplug|mapping|source)([[:blank:]]|$)/}
		{
			if (skip)
			{
				if (top($0)) skip=0
				else next
			}
			if ($0 ~ "^[[:blank:]]*#?[[:blank:]]*(allow-hotplug|auto)[[:blank:]]+" iface "([[:blank:]]|$)") next
			if ($0 ~ "^[[:blank:]]*iface[[:blank:]]+" iface "([[:blank:]]|$)") {skip=1; next}
			print
		}
	' "$source" > "$target" && cat "$target" > "$source"
	G_EXEC_NOEXIT=1 G_EXEC rm "$target"
}

Update_ResolvConf_Fallback()
{
	command -v resolvconf > /dev/null && return 0
	(( $CURRENT_IFACE_ENABLED )) || return 0
	[[ $CURRENT_IFACE_MODE_TARGET == 'static' ]] || return 0
	[[ $CURRENT_IFACE_DNS_STATIC ]] || return 0
	> /etc/resolv.conf
	local server
	for server in $CURRENT_IFACE_DNS_STATIC
	do
		echo "nameserver $server" >> /etc/resolv.conf
	done
}

Write_Interface_Config()
{
	local iface=$CURRENT_IFACE
	local fp="/etc/network/interfaces.d/$iface.conf"
	local dns_line='#dns-nameservers 9.9.9.9 149.112.112.112'
	local gateway_line="#gateway ${CURRENT_IFACE_IP_STATIC%.*}.1"
	G_EXEC mkdir -p /etc/network/interfaces.d
	[[ $CURRENT_IFACE_GATEWAY_STATIC ]] && gateway_line="gateway $CURRENT_IFACE_GATEWAY_STATIC"
	if command -v resolvconf > /dev/null && [[ $CURRENT_IFACE_DNS_STATIC ]]
	then
		dns_line="dns-nameservers $CURRENT_IFACE_DNS_STATIC"
	fi
	cat << _EOF_ > "$fp"
# Location: $fp
# Please modify network settings via: dietpi-network
$([[ $CURRENT_IFACE_ENABLED == 1 ]] && echo "allow-hotplug $iface" || echo "#allow-hotplug $iface")
_EOF_
	if [[ $CURRENT_IFACE_TYPE == 'wifi' && $CURRENT_IFACE_HOTSPOT == 1 ]]
	then
		CURRENT_IFACE_MODE_TARGET='static'
		cat << _EOF_ >> "$fp"
iface $iface inet static
address $CURRENT_IFACE_IP_STATIC
netmask $CURRENT_IFACE_MASK_STATIC
#gateway 192.168.0.1
#dns-nameservers 9.9.9.9 149.112.112.112
pre-up iw dev $iface set power_save off
post-down iw dev $iface set power_save on

# iptables NAT rules
up iptables-restore < /etc/iptables.ipv4.nat
up ip6tables-restore < /etc/iptables.ipv6.nat
_EOF_
		[[ ! -f '/etc/hostapd/hostapd.conf' ]] || G_CONFIG_INJECT 'interface=' "interface=$iface" /etc/hostapd/hostapd.conf
		[[ ! -f '/etc/default/isc-dhcp-server' ]] || G_CONFIG_INJECT 'INTERFACESv4=' "INTERFACESv4=\"$iface\"" /etc/default/isc-dhcp-server
	else
		cat << _EOF_ >> "$fp"
iface $iface inet $CURRENT_IFACE_MODE_TARGET
_EOF_
		if [[ $CURRENT_IFACE_MODE_TARGET == 'static' ]]
		then
			cat << _EOF_ >> "$fp"
address $CURRENT_IFACE_IP_STATIC
netmask $CURRENT_IFACE_MASK_STATIC
$gateway_line
$dns_line
_EOF_
		fi
		if [[ $CURRENT_IFACE_TYPE == 'wifi' ]]
		then
			cat << _EOF_ >> "$fp"
pre-up iw dev $iface set power_save off
post-down iw dev $iface set power_save on
wpa-conf /etc/wpa_supplicant/wpa_supplicant.conf
_EOF_
		fi
	fi

	if [[ $CURRENT_IFACE_TYPE == 'wifi' ]]
	then
		# shellcheck disable=SC2015
		(( $CURRENT_IFACE_HARDWARE )) && iw dev "$iface" set power_save on 2> /dev/null && iw dev "$iface" set power_save off 2> /dev/null || G_EXEC sed --follow-symlinks -i '/ iw dev .* set power_save /d' "$fp"
	fi

	Remove_Interface_From_Main_File "$iface"
	Update_ResolvConf_Fallback
}

Restart_Interface()
{
	local iface=$1
	if [[ $CURRENT_IFACE_TYPE == 'wifi' && $CURRENT_IFACE_HOTSPOT == 1 ]]
	then
		G_EXEC systemctl stop isc-dhcp-server hostapd
	fi

	G_DIETPI-NOTIFY 2 "Restarting $iface, please wait ..."
	G_EXEC systemctl daemon-reload
	if (( $CURRENT_IFACE_ENABLED )) && { [[ $CURRENT_IFACE_TYPE != 'wifi' || $CURRENT_IFACE_HOTSPOT == 1 ]] || grep -q '^network=' /etc/wpa_supplicant/wpa_supplicant.conf 2> /dev/null; }
	then
		G_EXEC_NOHALT=1 G_EXEC_OUTPUT=1 G_EXEC systemctl restart "ifup@$iface"
	else
		ifdown --force "$iface" 2> /dev/null
	fi

	if [[ $CURRENT_IFACE_TYPE == 'wifi' && $CURRENT_IFACE_HOTSPOT == 1 ]]
	then
		G_EXEC systemctl start hostapd isc-dhcp-server
	elif [[ $CURRENT_IFACE_TYPE == 'wifi' ]]
	then
		G_EXEC_NOEXIT=1 G_EXEC systemctl stop hostapd isc-dhcp-server
	fi

	G_SLEEP 2
	Load_Interface_State "$iface"
	G_DIETPI-NOTIFY 0 "$iface restarted"
}

