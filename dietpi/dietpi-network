			G_WHIP_MENU_ARRAY+=(
				'Scan' ': Scan and configure SSID'
				'Auto Reconnect' ": [$reconnect_text]"
				'' '●─ DHCP/STATIC IP '
				'Change Mode' ": [$mode_text]"
			)
			[[ $CURRENT_IFACE_MODE_TARGET == 'static' ]] && G_WHIP_MENU_ARRAY+=(
				'Copy' ': Copy current address to static'
				'Static IP' ": [$CURRENT_IFACE_IP_STATIC]"
				'Static Mask' ": [$CURRENT_IFACE_MASK_STATIC]"
				'Static Gateway' ": [$CURRENT_IFACE_GATEWAY_STATIC]"
				'Static DNS' ": [$CURRENT_IFACE_DNS_STATIC]"
			)
		fi
		G_WHIP_MENU_ARRAY+=(
			'' '●─ Additional Options '
			'Country' ": [$CURRENT_WIFI_COUNTRYCODE]"
		)
		if (( $CURRENT_IFACE_HOTSPOT ))
		then
			G_WHIP_MENU_ARRAY+=(
				'' '●─ Toggle State '
				'State' ": $hotspot_state_text"
			)
		else
			G_WHIP_MENU_ARRAY+=(
				'' '●─ Toggle State '
				'Disable' ': Disable WiFi adapter'
			)
		fi
		G_WHIP_MENU_ARRAY+=(
			'' '●─ Apply '
			'Apply' ': Save all changes and restart this interface'
		)
		NEXT_MENU="iface:$iface"
		G_WHIP_MENU "$description" || { Return_From_Submenu "iface:$iface"; return 0; }
		case $G_WHIP_RETURNED_VALUE in
			'Scan') /boot/dietpi/func/dietpi-wifidb;;
			'Auto Reconnect')
				if (( $CURRENT_IFACE_WIFI_AUTO_RECONNECT ))
				then
					G_EXEC systemctl disable --now dietpi-wifi-monitor
				else
					G_EXEC systemctl enable --now dietpi-wifi-monitor
				fi
			;;
			'Change Mode') [[ $CURRENT_IFACE_MODE_TARGET == 'dhcp' ]] && CURRENT_IFACE_MODE_TARGET='static' || CURRENT_IFACE_MODE_TARGET='dhcp'; [[ $CURRENT_IFACE_MODE_TARGET == 'static' ]] && G_WHIP_MSG 'When using STATIC IP, please ensure only one SSID entry exists in the scan menu.';;
			'Copy') Copy_Current_To_Static;;
			'Static IP') Change_StaticIp;;
			'Static Mask') Change_StaticMask;;
			'Static Gateway') Change_StaticGateway;;
			'Static DNS') Change_StaticDns;;
			'Country') Change_WifiCountryCode;;
			'Disable') G_WHIP_YESNO 'Would you like to disable this WiFi adapter?' && CURRENT_IFACE_ENABLED=0 && G_EXEC systemctl disable --now dietpi-wifi-monitor && Apply_Current_Interface 1 && Return_From_Submenu "iface:$iface";;
			'Apply')
				if (( $CURRENT_IFACE_HOTSPOT ))
				then
					Apply_Current_Interface 1
				else
					G_WHIP_YESNO 'WiFi will connect to the strongest configured SSID that is secure. Save all changes and restart this WiFi interface now?' && Apply_Current_Interface 1
				fi
			;;
			'SSID') G_WHIP_DEFAULT_ITEM=$HOTSPOT_SSID; G_WHIP_INPUTBOX 'Please enter an SSID for your WiFi hotspot:' && HOTSPOT_SSID=$G_WHIP_RETURNED_VALUE;;
			'Key')
				local error=
				G_WHIP_DEFAULT_ITEM=$HOTSPOT_KEY
				until (( ${#G_WHIP_RETURNED_VALUE} > 7 ))
				do
					G_WHIP_INPUTBOX "${error}Please enter a key/password with a minimum of 8 characters for your WiFi hotspot:" || return 0
					error='[FAILED] The entered key is too short.\n\n'
					G_WHIP_DEFAULT_ITEM=$G_WHIP_RETURNED_VALUE
				done
				HOTSPOT_KEY=$G_WHIP_RETURNED_VALUE
			;;
			'Frequency') HOTSPOT_5G=$(( ! $HOTSPOT_5G )); (( $HOTSPOT_5G && ! $HOTSPOT_WIFI5 && ! $HOTSPOT_WIFI6 )) && HOTSPOT_WIFI4=1;;
			'Channel')
				if (( $HOTSPOT_5G ))
				then
					G_WHIP_DEFAULT_ITEM=$HOTSPOT_5G_CHANNEL
					G_WHIP_INPUTBOX 'Please enter a 5 GHz WiFi channel for your hotspot:' && HOTSPOT_5G_CHANNEL=$G_WHIP_RETURNED_VALUE
				else
					local channel_mhz=2412
					G_WHIP_MENU_ARRAY=()
					for ((i=1; i<=13; i++))
					do
						G_WHIP_MENU_ARRAY+=("$i" ": $channel_mhz MHz")
						((channel_mhz+=5))
					done
					G_WHIP_DEFAULT_ITEM=$HOTSPOT_CHANNEL
					G_WHIP_MENU 'Please select a 2.4 GHz WiFi channel for your hotspot:' && HOTSPOT_CHANNEL=$G_WHIP_RETURNED_VALUE
				fi
			;;
			'802.11n') HOTSPOT_WIFI4=$(( ! $HOTSPOT_WIFI4 )); (( $HOTSPOT_WIFI4 || $HOTSPOT_WIFI5 || $HOTSPOT_WIFI6 )) || HOTSPOT_5G=0;;
			'802.11ac') HOTSPOT_WIFI5=$(( ! $HOTSPOT_WIFI5 )); (( $HOTSPOT_WIFI5 )) && HOTSPOT_5G=1; (( $HOTSPOT_WIFI4 || $HOTSPOT_WIFI5 || $HOTSPOT_WIFI6 )) || HOTSPOT_5G=0;;
			'802.11ax') HOTSPOT_WIFI6=$(( ! $HOTSPOT_WIFI6 )); (( $HOTSPOT_WIFI4 || $HOTSPOT_WIFI5 || $HOTSPOT_WIFI6 )) || HOTSPOT_5G=0;;
			'State')
				if (( $CURRENT_IFACE_HOTSPOT_ACTIVE ))
				then
					G_EXEC systemctl stop hostapd
				else
					G_EXEC systemctl start hostapd
				fi
			;;
			*) :;;
		esac
	fi
}

Input()
{
	while (( $# ))
	do
		case $1 in
			'apply')
				COMMAND='apply'
				shift
				APPLY_IFACE=$1
				[[ $APPLY_IFACE ]] || Error "Missing interface name for 'apply'.$USAGE"
			;;
			'remove')
				COMMAND='remove'
				shift
				ACTION_VALUE=$1
				[[ $ACTION_VALUE ]] || Error "Missing interface name for 'remove'.$USAGE"
			;;
			'wifi')
				if (( $# == 1 ))
				then
					COMMAND='menu'
					MENU_TARGET='wifi'
				else
					COMMAND='wifi'
					shift
					ACTION_VALUE=$1
				fi
			;;
			'proxy')
				if (( $# == 1 ))
				then
					COMMAND='menu'
					MENU_TARGET='proxy'
				else
					COMMAND='proxy'
					shift
					ACTION_VALUE=$1
					shift
					ACTION_EXTRA=$1
					(( $# )) && shift && set -- "$@"
					continue
				fi
			;;
			'country')
				if (( $# == 1 ))
				then
					COMMAND='menu'
					MENU_TARGET='country'
				else
					COMMAND='country'
					shift
					ACTION_VALUE=$1
				fi
			;;
			'ipv6') COMMAND='ipv6'; shift; ACTION_VALUE=$1;;
			'test')
				if (( $# == 1 ))
				then
					COMMAND='menu'
					MENU_TARGET='test'
				else
					COMMAND='test'
					shift
					ACTION_VALUE=$1
				fi
			;;
			'main') COMMAND='menu'; MENU_TARGET='main';;
			'--enable') APPLY_ENABLE=1;;
			'--disable') APPLY_ENABLE=0;;
			'--dhcp') APPLY_MODE='dhcp';;
			'--static') APPLY_MODE='static';;
			'--copy-current') APPLY_COPY_CURRENT=1;;
			'--client') APPLY_ROLE='client';;
			'--hotspot') APPLY_ROLE='hotspot';;
			'--ip') shift; APPLY_IP=$1;;
			'--mask') shift; APPLY_MASK=$1;;
			'--gateway') shift; APPLY_GATEWAY=$1;;
			'--dns') shift; APPLY_DNS=$1;;
			'--ssid') shift; APPLY_SSID=$1;;
			'--key') shift; APPLY_KEY=$1;;
			'--freq') shift; APPLY_FREQ=$1;;
			'--channel') shift; APPLY_CHANNEL=$1;;
			'--wifi4') shift; APPLY_WIFI4=$1;;
			'--wifi5') shift; APPLY_WIFI5=$1;;
			'--wifi6') shift; APPLY_WIFI6=$1;;
			'--no-restart') APPLY_RESTART=0;;
			'-h'|'--help'|'help') echo "$USAGE"; exit 0;;
			*)
				if [[ $COMMAND == 'menu' && $MENU_TARGET == 'main' ]]
				then
					MENU_TARGET="iface:$1"
				else
					Error "Invalid input ($1). Aborting ...$USAGE"
				fi
			;;
		esac
		shift
	done
}

Apply_From_CLI()
{
	[[ $APPLY_IFACE ]] || Error "Missing interface name for 'apply'.$USAGE"
	[[ -d /sys/class/net/$APPLY_IFACE ]] || Error "Network interface '$APPLY_IFACE' was not detected."
	Load_Interface_State "$APPLY_IFACE"
	[[ $APPLY_ENABLE == '' ]] || CURRENT_IFACE_ENABLED=$APPLY_ENABLE
	[[ $APPLY_MODE ]] && CURRENT_IFACE_MODE_TARGET=$APPLY_MODE
	(( $APPLY_COPY_CURRENT )) && Copy_Current_To_Static
	[[ $APPLY_IP ]] && CURRENT_IFACE_IP_STATIC=$APPLY_IP
	[[ $APPLY_MASK ]] && CURRENT_IFACE_MASK_STATIC=$APPLY_MASK
	[[ $APPLY_GATEWAY ]] && CURRENT_IFACE_GATEWAY_STATIC=$APPLY_GATEWAY
	[[ $APPLY_DNS ]] && CURRENT_IFACE_DNS_STATIC=$APPLY_DNS
	if [[ $CURRENT_IFACE_TYPE == 'wifi' && $APPLY_ROLE ]]
	then
		if [[ $APPLY_ROLE == 'hotspot' ]]
		then
			CURRENT_IFACE_HOTSPOT=1
			CURRENT_IFACE_MODE_TARGET='static'
			[[ $APPLY_IP ]] || CURRENT_IFACE_IP_STATIC='192.168.42.1'
			[[ $APPLY_MASK ]] || CURRENT_IFACE_MASK_STATIC='255.255.255.0'
			Load_Hotspot_Settings
		else
			CURRENT_IFACE_HOTSPOT=0
		fi
	fi
	[[ $APPLY_SSID ]] && HOTSPOT_SSID=$APPLY_SSID
	[[ $APPLY_KEY ]] && HOTSPOT_KEY=$APPLY_KEY
	if [[ $APPLY_FREQ == '5' ]]
	then
		HOTSPOT_5G=1
	elif [[ $APPLY_FREQ == '2.4' ]]
	then
		HOTSPOT_5G=0
	fi
	if [[ $APPLY_CHANNEL ]]
	then
		if (( $HOTSPOT_5G ))
		then
			HOTSPOT_5G_CHANNEL=$APPLY_CHANNEL
		else
			HOTSPOT_CHANNEL=$APPLY_CHANNEL
		fi
	fi
	[[ $APPLY_WIFI4 =~ ^[01]$ ]] && HOTSPOT_WIFI4=$APPLY_WIFI4
	[[ $APPLY_WIFI5 =~ ^[01]$ ]] && HOTSPOT_WIFI5=$APPLY_WIFI5
	[[ $APPLY_WIFI6 =~ ^[01]$ ]] && HOTSPOT_WIFI6=$APPLY_WIFI6
	Apply_Current_Interface "$APPLY_RESTART" || exit 1
}

Remove_From_CLI()
{
	[[ -f /etc/network/interfaces.d/$ACTION_VALUE.conf ]] && G_EXEC rm "/etc/network/interfaces.d/$ACTION_VALUE.conf"
	Remove_Interface_From_Main_File "$ACTION_VALUE"
	ifdown --force "$ACTION_VALUE" 2> /dev/null
}

Proxy_From_CLI()
{
	Load_Proxy_Vars
	case $ACTION_VALUE in
		'enable') PROXY_ENABLED=1;;
		'disable') PROXY_ENABLED=0;;
		'address') PROXY_ADDRESS=$ACTION_EXTRA;;
		'port') PROXY_PORT=$ACTION_EXTRA;;
		'username') PROXY_USERNAME=$ACTION_EXTRA;;
		'password') PROXY_PASSWORD=$ACTION_EXTRA;;
		*) Error "Invalid proxy action ($ACTION_VALUE).$USAGE";;
	esac
	Apply_Proxy_Settings
}

Wifi_From_CLI()
{
	case $ACTION_VALUE in
		'enable'|'disable'|'onboard_enable'|'onboard_disable'|'onboard-enable'|'onboard-disable')
			ACTION_VALUE=${ACTION_VALUE//-/_}
			/boot/dietpi/func/dietpi-set_hardware wifimodules "$ACTION_VALUE"
		;;
		*) Error "Invalid wifi action ($ACTION_VALUE).$USAGE";;
	esac
}

Country_From_CLI(){ [[ $ACTION_VALUE ]] || Error "Missing WiFi country code.$USAGE"; /boot/dietpi/func/dietpi-set_hardware wificountrycode "$ACTION_VALUE"; }
IPv6_From_CLI(){ [[ $ACTION_VALUE ]] || Error "Missing IPv6 action.$USAGE"; /boot/dietpi/func/dietpi-set_hardware enableipv6 "$ACTION_VALUE"; }
Test_From_CLI(){ G_CHECK_URL "${ACTION_VALUE:-$INTERNET_TEST_URL}"; }

Menu_Main()
{
	case $NEXT_MENU in
		'main') Menu_Global;;
		'wifi') Menu_Wifi_Global;;
		'proxy') Menu_Proxy;;
		'country') Load_Interface_State "${WIFI_INTERFACES[0]:-wlan0}"; Change_WifiCountryCode; Return_From_Submenu 'country';;
		'test') Menu_Test;;
		iface:*) Menu_Interface "${NEXT_MENU#iface:}";;
		'exit') return 1;;
		*) NEXT_MENU='main';;
	esac
	return 0
}

Input "$@"

case $COMMAND in
	'apply') Apply_From_CLI; exit 0;;
	'remove') Remove_From_CLI; exit 0;;
	'proxy') Proxy_From_CLI; exit 0;;
	'wifi') Wifi_From_CLI; exit 0;;
	'country') Country_From_CLI; exit 0;;
	'ipv6') IPv6_From_CLI; exit 0;;
	'test') Test_From_CLI; exit 0;;
	'menu') :;;
	*) Error "Unknown command ($COMMAND).$USAGE";;
esac

(( $G_DIETPI_INSTALL_STAGE >= 0 )) || { G_WHIP_MSG '[ INFO ] First run setup has not reached sufficient state. Please reboot before using DietPi-Network.'; exit 1; }
Get_Interfaces
ENTRY_TARGET=$MENU_TARGET
NEXT_MENU=$MENU_TARGET
while Menu_Main; do :; done

exit 0
}
