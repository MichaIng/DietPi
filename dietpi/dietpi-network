Menu_Interface()
{
	local iface=$1
	[[ -d /sys/class/net/$iface ]] || { G_WHIP_MSG "Network interface '$iface' was not detected."; Return_From_Submenu "iface:$iface"; return 0; }
	Load_Interface_State "$iface"
	Net_Update_UsageStats "$iface"
	local title=$(Interface_Menu_Title)
	if [[ $CURRENT_IFACE_TYPE == 'eth' ]]
	then
		local mode_text='DHCP' speed='auto (default)'
		[[ $CURRENT_IFACE_MODE_TARGET == 'static' ]] && mode_text='STATIC'
		[[ -f '/etc/systemd/system/ethtool_force_speed.service' ]] && grep -q "WantedBy=ifup@$iface.service" /etc/systemd/system/ethtool_force_speed.service && speed=$(mawk '/^ExecStart=/{print $5;exit}' /etc/systemd/system/ethtool_force_speed.service)
		G_WHIP_MENU_ARRAY=(
			'' '●─ DHCP/STATIC IP '
			'Change Mode' ": [$mode_text]"
		)
		[[ $CURRENT_IFACE_MODE_TARGET == 'static' ]] && G_WHIP_MENU_ARRAY+=(
			'Copy' ': Copy current address to static'
			'Static IP' ": [$CURRENT_IFACE_IP_STATIC]"
			'Static Mask' ": [$CURRENT_IFACE_MASK_STATIC]"
			'Static Gateway' ": [$CURRENT_IFACE_GATEWAY_STATIC]"
			'Static DNS' ": [$CURRENT_IFACE_DNS_STATIC]"
		)
		G_WHIP_MENU_ARRAY+=(
			'' '●─ Additional Options '
			'Link Speed' ": [$speed]"
			'Disable' ': Disable Ethernet adapter'
			'' '●─ Apply '
			'Apply' ': Save all changes and restart this interface'
		)
		NEXT_MENU="iface:$iface"
		G_WHIP_MENU "${title}\nUsage   : Sent = $NET_TX_MB | Received = $NET_RX_MB\nAddress : IP = $CURRENT_IFACE_IP | Mask = $CURRENT_IFACE_MASK | Gateway = $CURRENT_IFACE_GATEWAY | DNS = $DNS_CURRENT" || { Return_From_Submenu "iface:$iface"; return 0; }
		case $G_WHIP_RETURNED_VALUE in
			'Change Mode') [[ $CURRENT_IFACE_MODE_TARGET == 'dhcp' ]] && CURRENT_IFACE_MODE_TARGET='static' || CURRENT_IFACE_MODE_TARGET='dhcp';;
			'Copy') Copy_Current_To_Static;;
			'Static IP') Change_StaticIp;;
			'Static Mask') Change_StaticMask;;
			'Static Gateway') Change_StaticGateway;;
			'Static DNS') Change_StaticDns;;
			'Link Speed')
				G_AG_CHECK_INSTALL_PREREQ ethtool
				G_WHIP_MENU_ARRAY=('0' ': Auto-negotiation (default)')
				while read -r item
				do
					item=${item//[^0-9]}
					[[ $item ]] && G_WHIP_MENU_ARRAY+=("$item" ": Force $item Mbit link speed")
				done < <(ethtool "$iface" | sed -n '/Supported link modes:/,/^[[:blank:]]*[[:alpha:]]/p' | head -n -1 | mawk '{print $NF}')
				G_WHIP_MENU 'Please select a supported Ethernet link speed to force or auto-negotiation.' && /boot/dietpi/func/dietpi-set_hardware eth-forcespeed "$G_WHIP_RETURNED_VALUE" "$iface"
			;;
			'Disable') G_WHIP_YESNO 'Would you like to disable this Ethernet adapter?' && CURRENT_IFACE_ENABLED=0 && Apply_Current_Interface 1 && Return_From_Submenu "iface:$iface";;
			'Apply') G_WHIP_YESNO 'Apply settings and reconnect this Ethernet interface now?' && Apply_Current_Interface 1;;
