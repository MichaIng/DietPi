#!/bin/bash
# shellcheck disable=SC2034
# Available DietPi version
G_REMOTE_VERSION_CORE=10
G_REMOTE_VERSION_SUB=8
G_REMOTE_VERSION_RC=2
# Minimum DietPi version to allow update
G_MIN_VERSION_CORE=8
G_MIN_VERSION_SUB=0
# Alternative Git branch to automatically migrate to when DietPi version is too low
G_OLD_VERSION_BRANCH='9'
# Minimum Debian version to allow update
G_MIN_DEBIAN=7
# Alternative Git branch to automatically migrate to when Debian version is too low
G_OLD_DEBIAN_BRANCH='9'
# Live patches
G_LIVE_PATCH_DESC=('Fix ownership of files extracted from upstream archives by dietpi-software, e.g. the uv binary')
G_LIVE_PATCH_COND=('grep -q '\''G_EXEC tar xf "$file" ${target:+'\'' /boot/dietpi/dietpi-software')
# shellcheck disable=SC2016
G_LIVE_PATCH=('sed --follow-symlinks -i '\''s/G_EXEC tar xf "$file" ${target:+/G_EXEC tar xf "$file" --no-same-owner ${target:+/'\'' /boot/dietpi/dietpi-software; for lp_path in uv:/usr/local/bin/uv frp:/usr/local/bin/frps frp:/usr/local/bin/frpc kubo:/usr/local/bin/ipfs spotifyd:/opt/spotifyd birdnetgo:/opt/birdnet openvpn:/etc/openvpn/easy-rsa; do grep -q "^[[:blank:]]*aSOFTWARE_INSTALL_STATE\[${lp_path%%:*}\]=2" /boot/dietpi/.installed && [[ -e ${lp_path#*:} ]] && chown -R root:root "${lp_path#*:}"; done')
